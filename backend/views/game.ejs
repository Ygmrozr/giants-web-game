function updateGasPickupEffects() {
  for (let i = gasPickupEffects.length - 1; i >= 0; i--) {
    const e = gasPickupEffects[i];

    e.life--;

    for (let j = e.particles.length - 1; j >= 0; j--) {
      const p = e.particles[j];

      p.x += p.vx;
      p.y += p.vy;
      p.vx *= 0.94;
      p.vy *= 0.96;
      p.size *= 1.025;
      p.life--;

      if (p.life <= 0) {
        e.particles.splice(j, 1);
      }
    }

    if (e.life <= 0 && e.particles.length === 0) {
      gasPickupEffects.splice(i, 1);
    }
  }
}

function spawnTitanSteam(titan) {
  const rect = getTitanDrawRect(titan);

  const centerX = rect.x + rect.width / 2;
  const centerY = rect.y + rect.height * 0.52;

  const isBoss = titan.isBoss || titan.isFemaleTitan;

  titanSteamEffects.push({
    x: centerX,
    y: centerY,
    life: isBoss ? 150 : 120,
    maxLife: isBoss ? 150 : 120,
    radius: isBoss ? 55 : 38,
    hazeAlpha: isBoss ? 0.34 : 0.26,
    wisps: Array.from({ length: isBoss ? 36 : 24 }, () => ({
      x: centerX + rand(-rect.width * 0.22, rect.width * 0.22),
      y: centerY + rand(-rect.height * 0.18, rect.height * 0.18),
      vx: rand(-0.45, 0.45),
      vy: rand(-2.2, -0.7),
      sizeX: rand(18, isBoss ? 42 : 30),
      sizeY: rand(9, isBoss ? 22 : 16),
      growth: rand(0.12, 0.28),
      drift: rand(-0.02, 0.02),
      alpha: rand(0.10, 0.22),
      life: randInt(55, isBoss ? 150 : 120),
      maxLife: randInt(55, isBoss ? 150 : 120),
      rot: rand(-0.7, 0.7),
      rotSpeed: rand(-0.015, 0.015)
    })),
    puffs: Array.from({ length: isBoss ? 16 : 10 }, () => ({
      x: centerX + rand(-rect.width * 0.15, rect.width * 0.15),
      y: centerY + rand(-rect.height * 0.12, rect.height * 0.12),
      vx: rand(-0.25, 0.25),
      vy: rand(-1.4, -0.5),
      r: rand(20, isBoss ? 42 : 32),
      growth: rand(0.18, 0.34),
      alpha: rand(0.08, 0.16),
      life: randInt(45, isBoss ? 120 : 95),
      maxLife: randInt(45, isBoss ? 120 : 95)
    }))
  });

  playSfx("titanSteam", isBoss ? 0.65 : 0.5, 250);
}

function updateTitanSteamEffects() {
  for (let i = titanSteamEffects.length - 1; i >= 0; i--) {
    const e = titanSteamEffects[i];

    e.life--;
    e.radius += 0.18;

    for (let j = e.wisps.length - 1; j >= 0; j--) {
      const w = e.wisps[j];

      w.x += w.vx;
      w.y += w.vy;
      w.vx += w.drift;
      w.vx *= 0.992;
      w.vy *= 0.992;
      w.sizeX += w.growth;
      w.sizeY += w.growth * 0.55;
      w.rot += w.rotSpeed;
      w.life--;

      if (w.life <= 0) {
        e.wisps.splice(j, 1);
      }
    }

    for (let j = e.puffs.length - 1; j >= 0; j--) {
      const p = e.puffs[j];

      p.x += p.vx;
      p.y += p.vy;
      p.vx *= 0.99;
      p.vy *= 0.992;
      p.r += p.growth;
      p.life--;

      if (p.life <= 0) {
        e.puffs.splice(j, 1);
      }
    }

    if (e.life <= 0 && e.wisps.length === 0 && e.puffs.length === 0) {
      titanSteamEffects.splice(i, 1);
    }
  }
}

function drawTitanSteamEffects() {
  ctx.save();
  ctx.globalCompositeOperation = "screen";

  for (const e of titanSteamEffects) {
    const effectAlpha = Math.max(0, e.life / e.maxLife);

    // Ana yumuşak merkez buhar
    const coreGlow = ctx.createRadialGradient(
      e.x - camera.x,
      e.y,
      8,
      e.x - camera.x,
      e.y,
      e.radius * 2.8
    );

    coreGlow.addColorStop(0, `rgba(235,245,245,${e.hazeAlpha * effectAlpha})`);
    coreGlow.addColorStop(0.35, `rgba(200,215,215,${e.hazeAlpha * 0.62 * effectAlpha})`);
    coreGlow.addColorStop(1, "rgba(200,215,215,0)");

    ctx.fillStyle = coreGlow;
    ctx.beginPath();
    ctx.arc(e.x - camera.x, e.y, e.radius * 2.8, 0, Math.PI * 2);
    ctx.fill();

    // Büyük yumuşak bulutlar
    for (const p of e.puffs) {
      const alpha = Math.max(0, (p.life / p.maxLife) * p.alpha);

      ctx.fillStyle = `rgba(220,230,230,${alpha})`;
      ctx.beginPath();
      ctx.ellipse(
        p.x - camera.x,
        p.y,
        p.r * 1.55,
        p.r * 0.9,
        0,
        0,
        Math.PI * 2
      );
      ctx.fill();
    }

    // İnce yükselen wispler
    for (const w of e.wisps) {
      const alpha = Math.max(0, (w.life / w.maxLife) * w.alpha);

      ctx.save();
      ctx.translate(w.x - camera.x, w.y);
      ctx.rotate(w.rot);

      const wispGradient = ctx.createRadialGradient(0, 0, 0, 0, 0, w.sizeX);
      wispGradient.addColorStop(0, `rgba(245,250,250,${alpha})`);
      wispGradient.addColorStop(0.55, `rgba(220,230,230,${alpha * 0.55})`);
      wispGradient.addColorStop(1, "rgba(220,230,230,0)");

      ctx.fillStyle = wispGradient;
      ctx.beginPath();
      ctx.ellipse(0, 0, w.sizeX, w.sizeY, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.restore();
    }
  }

  ctx.restore();
}

