    function drawBloodEffects() {
  for (const p of bloodEffects) {
    const alpha = Math.max(0, p.life / p.maxLife);

    ctx.save();
    ctx.globalAlpha = alpha;

    if (p.type === "streak") {
      ctx.strokeStyle = "rgba(130,0,0,1)";
      ctx.lineWidth = p.size;

      ctx.beginPath();
      ctx.moveTo(p.x - camera.x, p.y);
      ctx.lineTo(
        p.x - camera.x - p.vx * 2.2,
        p.y - p.vy * 1.2
      );
      ctx.stroke();
    } else {
      ctx.fillStyle = "rgba(150,0,0,1)";
      ctx.beginPath();
      ctx.arc(p.x - camera.x, p.y, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.restore();
  }
}

