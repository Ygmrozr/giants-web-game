    ctx.fillText("Gaz bitti!", 540, 70);
  }

  // TITAN YAKALAMA PANELİ
  if (player.grabbed) {
    ctx.fillStyle = "rgba(0,0,0,0.76)";
    ctx.fillRect(380, 24, 440, 86);

    ctx.strokeStyle = "rgba(215,175,100,0.85)";
    ctx.lineWidth = 1.5;
    ctx.strokeRect(380, 24, 440, 86);

    ctx.fillStyle = "#ff4a3d";
    ctx.font = "bold 20px Arial";
    ctx.textAlign = "center";
    ctx.fillText("GRABBED! PRESS SPACE TO ESCAPE", 600, 55);

    ctx.fillStyle = "rgba(255,255,255,0.25)";
    ctx.fillRect(460, 72, 280, 16);

    ctx.fillStyle = "#2ecc71";
    ctx.fillRect(
      460,
      72,
      280 * Math.min(player.escapeProgress / 100, 1),
      16
    );

    ctx.strokeStyle = "white";
    ctx.strokeRect(460, 72, 280, 16);

    ctx.textAlign = "left";
  }

  ctx.restore();
}

function drawFinalStrikeEffect() {
  if (finalStrikeTimer <= 0) return;

  const alpha = finalStrikeTimer / 20;

  ctx.fillStyle = `rgba(120,0,0,${0.12 * alpha})`;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  ctx.fillStyle = `rgba(255,255,255,${0.18 * alpha})`;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
}

function drawLowHealthEffect() {
  const healthRatio = player.health / player.maxHealth;

  if (healthRatio > 0.45) return;
const alpha = healthRatio < 0.20
  ? (1 - healthRatio) * 0.75
  : (1 - healthRatio) * 0.45;

  const gradient = ctx.createRadialGradient(
    canvas.width / 2,
    canvas.height / 2,
    canvas.height * 0.15,
    canvas.width / 2,
    canvas.height / 2,
    canvas.width * 0.75
  );

  gradient.addColorStop(0, `rgba(0,0,0,0)`);
  gradient.addColorStop(1, `rgba(120,0,0,${alpha})`);

  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
}

    function drawGameMessage() {
