    activeCivilian.y + activeCivilian.height >= ground.y - 4 &&
    Math.abs(femaleTitan.x - activeCivilian.x) < 140
  ) {
killCivilian("Female Titan killed the civilian!");  }

  if (
  activeCivilian &&
  !activeCivilian.following &&
  !activeCivilian.rescued &&
  isCivilianInSafeZone(activeCivilian)
) {
