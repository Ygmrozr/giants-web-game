function calculateRankPoints() {
  const totalTitans = Math.max(1, titans.length);
  const killedTitans = titanKillCount;

  const totalItems = Math.max(1, items.length);
  const collectedItems = items.filter(item => item.collected).length;

  const titanRatio = killedTitans / totalTitans;
  const itemRatio = collectedItems / totalItems;

  // Çok titanlı maplerde S için hepsini öldürme zorunluluğu olmasın
  const titanScore = Math.min(titanRatio / 0.85, 1) * 42;

  // Item tarafında da hepsini toplamak yerine %85 üstü çok iyi sayılsın
  const itemScoreRank = Math.min(itemRatio / 0.85, 1) * 33;

  const comboScore = Math.min(savedBestCombo / 7, 1) * 15;
  const scoreBonus = Math.min(getTotalScore() / 3500, 1) * 10;

  return Math.floor(
    titanScore +
    itemScoreRank +
    comboScore +
    scoreBonus
  );
}

function calculatePreviewRank() {
  const points = calculateRankPoints();

  if (points >= 94) return "S";
  if (points >= 84) return "A";
  if (points >= 68) return "B";
  if (points >= 48) return "C";
  return "D";
}

function getRankColor(rank) {
  if (rank === "S") return "#ffd700";
  if (rank === "A") return "#3da8ff";
  if (rank === "B") return "#4caf50";
  if (rank === "C") return "#ffa726";
  return "#ff4d4d";
}

function getRankStarCount(rank) {
  if (rank === "S") return 5;
  if (rank === "A") return 4;
  if (rank === "B") return 3;
  if (rank === "C") return 2;
  return 1;
}

function getNextRankTarget(points) {
  if (points < 45) return 45;
  if (points < 75) return 75;
  if (points < 105) return 105;
  if (points < 170) return 170;
  return 170;
}

function openSectorResultPanel() {
  const rank = calculatePreviewRank();
  const rankPoints = calculateRankPoints();
  const rankColor = getRankColor(rank);

  pendingSectorResult = {
    score: getTotalScore(),
    titanKills: titanKillCount,
    itemsCollected: itemCollectedCount,
    medals: collectedMedalCount,
    bestCombo: savedBestCombo,
    rank
  };

  const rankEl = document.getElementById("resultRank");
  rankEl.textContent = rank;
  rankEl.style.color = rankColor;
  rankEl.style.textShadow = `0 0 28px ${rankColor}`;

  document.getElementById("resultScore").textContent = pendingSectorResult.score;
  document.getElementById("resultKills").textContent = pendingSectorResult.titanKills;
  document.getElementById("resultMedals").textContent = pendingSectorResult.medals;
  document.getElementById("resultCombo").textContent = pendingSectorResult.bestCombo;
  document.getElementById("resultReward").textContent = "After Save";

  document.getElementById("resultTotalScore").textContent = pendingSectorResult.score;
  document.getElementById("resultRankPoints").textContent = rankPoints;

  document.getElementById("bestScoreText").textContent =
    `BEST: ${pendingSectorResult.score}`;

  document.getElementById("bestKillsText").textContent =
    `BEST: ${pendingSectorResult.titanKills}`;

  document.getElementById("bestMedalsText").textContent =
    `BEST: ${pendingSectorResult.medals}`;

  document.getElementById("bestComboText").textContent =
    `MAX: ${pendingSectorResult.bestCombo}`;

  const stars = document.querySelectorAll("#resultStars span");
  const activeStars = getRankStarCount(rank);

  stars.forEach((star, index) => {
    star.classList.toggle("active", index < activeStars);
  });

  const nextTarget = getNextRankTarget(rankPoints);
  const progressPercent =
    nextTarget === 170 && rankPoints >= 170
      ? 100
      : Math.min(100, Math.floor((rankPoints / nextTarget) * 100));

  document.getElementById("nextRankProgress").style.width =
    progressPercent + "%";

  document.getElementById("nextRankText").textContent =
    rankPoints >= 170
      ? "MAX RANK"
      : `${rankPoints} / ${nextTarget}`;

  game.state = "result";
  document.getElementById("sectorResultPanel").style.display = "flex";
}

async function submitSectorCompletion() {
  if (!pendingSectorResult) return null;

  const response = await fetch(`/game/<%= level %>/<%= sector %>/complete`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
  score: pendingSectorResult.score,
  titanKills: pendingSectorResult.titanKills,
  itemsCollected: pendingSectorResult.itemsCollected,
  medals: pendingSectorResult.medals,
  bestCombo: pendingSectorResult.bestCombo,
  rank: pendingSectorResult.rank
})
  });

  return await response.json();
}

