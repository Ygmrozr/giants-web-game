const sfxCooldowns = {};

function playSfx(name, volume = 0.45, cooldown = 120) {
  const baseSound = sfx[name];
  if (!baseSound) return;

  const now = performance.now();

  if (sfxCooldowns[name] && now - sfxCooldowns[name] < cooldown) {
    return;
  }

  sfxCooldowns[name] = now;

  // Uzun ölüm sesinde aynı Audio nesnesini başa sarma, kopya çal
  const cloneSounds = [
  "titanDeath",
  "playerStep",
  "titanStep",
  "bladeSwing",
  "titanHit"
];

const sound = cloneSounds.includes(name)
  ? baseSound.cloneNode()
  : baseSound;

  sound.volume = volume;
  sound.currentTime = 0;
  sound.play().catch(() => {});
}

