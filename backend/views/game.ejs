function drawLowHealthEffect() {
  const healthRatio = player.health / player.maxHealth;

  if (healthRatio > 0.45) return;

  const pulse =
    0.5 + Math.sin(performance.now() * 0.008) * 0.5;

  const baseAlpha = healthRatio < 0.20
    ? (1 - healthRatio) * 0.75
    : (1 - healthRatio) * 0.45;

  const alpha = baseAlpha + pulse * 0.12;

  const gradient = ctx.createRadialGradient(
    canvas.width / 2,
    canvas.height / 2,
    canvas.height * 0.15,
    canvas.width / 2,
    canvas.height / 2,
    canvas.width * 0.75
  );

  gradient.addColorStop(0, "rgba(0,0,0,0)");
  gradient.addColorStop(1, `rgba(120,0,0,${alpha})`);

  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, canvas.width, canvas.height);
}

