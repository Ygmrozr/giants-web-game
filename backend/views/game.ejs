  stepTimer: 0,
  stepInterval: 170,
  steamTimer: 0,

  finished: false
};

let colossalSteamParticles = [];

function resetColossalBackgroundTitan() {
  colossalBg.active = isBattle5Sector();

  colossalBg.x = -420;
  colossalBg.y = 20;

  colossalBg.speed = 0.42;
  colossalBg.alpha = 0.56;

  colossalBg.bobOffset = 0;
  colossalBg.stepTimer = 0;
  colossalBg.stepInterval = 170;
  colossalBg.steamTimer = 0;
  colossalBg.finished = false;

  colossalSteamParticles = [];
}

function updateColossalBackgroundTitan() {
  if (
    !colossalBg.active ||
    colossalBg.finished ||
    game.state !== "playing"
  ) {
    updateColossalSteamParticles();
    return;
  }

  // Haritanın başından sonuna doğru ilerler
  colossalBg.x += colossalBg.speed;

  const time = performance.now() * 0.0014;
  colossalBg.bobOffset = Math.sin(time) * 3;

  colossalBg.stepTimer++;
  colossalBg.steamTimer++;

  // Haritanın sonuna ulaşınca durur
  if (colossalBg.x >= WORLD.width + 250) {
    colossalBg.x = WORLD.width + 250;
    colossalBg.finished = true;
  }

  // Yürüyüş sırasında omuz ve sırt buharı
  if (colossalBg.steamTimer >= 15) {
    colossalBg.steamTimer = 0;

    spawnColossalSteam(
      colossalBg.x + colossalBg.width * 0.48 +
        randomRange(-25, 25),

      colossalBg.y + colossalBg.height * 0.20 +
        randomRange(-18, 18),

      2
    );
  }

  // Ağır adım efekti
  if (colossalBg.stepTimer >= colossalBg.stepInterval) {
    colossalBg.stepTimer = 0;

    spawnColossalSteam(
      colossalBg.x + colossalBg.width * 0.43,
      colossalBg.y + colossalBg.height * 0.30,
      7
    );

    spawnColossalSteam(
      colossalBg.x + colossalBg.width * 0.58,
      colossalBg.y + colossalBg.height * 0.23,
      5
    );

    screenShakeTimer = Math.max(screenShakeTimer, 3);
  }

  updateColossalSteamParticles();
}

function randomRange(min, max) {
  return Math.random() * (max - min) + min;
}

function spawnColossalSteam(x, y, amount = 5) {
  for (let i = 0; i < amount; i++) {
    colossalSteamParticles.push({
      x,
      y,
      vx: randomRange(-0.5, 0.5),
      vy: randomRange(-2.8, -1.2),
      size: randomRange(18, 42),
      alpha: randomRange(0.18, 0.34),
      life: randomRange(50, 90),
      maxLife: 90
    });
  }
}

function updateColossalSteamParticles() {
  for (let i = colossalSteamParticles.length - 1; i >= 0; i--) {
    const p = colossalSteamParticles[i];

    p.x += p.vx;
    p.y += p.vy;
    p.life--;
    p.alpha *= 0.985;
    p.size += 0.22;

    if (p.life <= 0 || p.alpha <= 0.01) {
      colossalSteamParticles.splice(i, 1);
    }
  }
}

function drawColossalSteamParticles() {
  for (const p of colossalSteamParticles) {
    const px =
  p.x -
  camera.x * COLOSSAL_PARALLAX_SPEED;
    const py = p.y;

    const alpha = Math.max(0, (p.life / p.maxLife) * p.alpha);

    const grad = ctx.createRadialGradient(
      px, py, 0,
      px, py, p.size
    );

    grad.addColorStop(0, `rgba(255,255,255,${alpha})`);
    grad.addColorStop(0.45, `rgba(220,220,220,${alpha * 0.75})`);
    grad.addColorStop(1, "rgba(80,80,80,0)");

    ctx.save();
    ctx.fillStyle = grad;
    ctx.beginPath();
    ctx.arc(px, py, p.size, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }
}

function drawColossalBackgroundTitan() {
  if (
    !colossalBg.active ||
    !colossalBgSprite.complete ||
    colossalBgSprite.naturalWidth === 0
  ) {
    return;
  }

  const drawX =
    colossalBg.x -
    camera.x * COLOSSAL_PARALLAX_SPEED;

  const drawY =
    colossalBg.y +
    colossalBg.bobOffset;

  // Ekran dışında olduğunda gereksiz çizim yapma
  if (
    drawX + colossalBg.width < -100 ||
    drawX > canvas.width + 100
  ) {
    return;
  }

  ctx.save();

  ctx.globalAlpha = colossalBg.alpha;

  const glowX = drawX + colossalBg.width * 0.5;
  const glowY = drawY + colossalBg.height * 0.34;

  const glow = ctx.createRadialGradient(
    glowX,
    glowY,
    0,
    glowX,
    glowY,
    colossalBg.width * 0.72
  );

  glow.addColorStop(
    0,
    "rgba(255,135,55,0.13)"
  );

  glow.addColorStop(
    0.45,
    "rgba(255,75,20,0.07)"
  );

  glow.addColorStop(
    1,
    "rgba(0,0,0,0)"
  );

  ctx.fillStyle = glow;

  ctx.beginPath();

  ctx.arc(
    glowX,
    glowY,
    colossalBg.width * 0.72,
    0,
    Math.PI * 2
  );

  ctx.fill();

  ctx.drawImage(
    colossalBgSprite,
    drawX,
    drawY,
    colossalBg.width,
    colossalBg.height
  );

  ctx.restore();

  drawColossalSteamParticles();
}


