      speedX: rand(-0.45, -0.12),
      speedY: rand(-0.18, 0.08),
      alpha: rand(0.28, 0.65),
      flicker: rand(0, Math.PI * 2)
    });
  }

  // Performans dostu siyah kül
for (let i = 24; i < 90 + 28; i++) {
  atmosphereParticles.push({
    type: "blackAsh",
    x: rand(0, WORLD.width),
    y: rand(40, canvas.height - 50),
    size: rand(2.2, 4.5),
    speedX: rand(-0.26, -0.06),
    speedY: rand(0.03, 0.13),
    alpha: rand(0.20, 0.38)
  });
}

}


function updateAtmosphereParticles() {
  for (const p of atmosphereParticles) {
    p.x += p.speedX;
    p.y += p.speedY;

    if (p.type === "ember") {
      p.flicker += 0.18;
      p.y += Math.sin(p.flicker) * 0.15;
    }

    if (p.x < 0) p.x = WORLD.width;
    if (p.x > WORLD.width) p.x = 0;

    if (p.y < 20) p.y = canvas.height - 40;
    if (p.y > canvas.height - 20) p.y = 40;
  }
}

function drawAtmosphereParticles() {
  ctx.save();

  for (const p of atmosphereParticles) {
    const drawX = p.x - camera.x;
    const drawY = p.y;

    if (drawX < -60 || drawX > canvas.width + 60) continue;

    if (p.type === "dust") {
      ctx.globalCompositeOperation = "screen";

      const gradient = ctx.createRadialGradient(
        drawX,
        drawY,
        0,
        drawX,
        drawY,
        p.size
      );

      gradient.addColorStop(0, `rgba(210,150,75,${p.alpha})`);
      gradient.addColorStop(0.45, `rgba(130,90,55,${p.alpha * 0.45})`);
      gradient.addColorStop(1, "rgba(80,50,30,0)");

      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    if (p.type === "ember") {
  const flickerAlpha = p.alpha * (0.75 + Math.sin(p.flicker) * 0.15);

  ctx.globalCompositeOperation = "screen";
  ctx.fillStyle = `rgba(255,95,25,${flickerAlpha})`;

  ctx.beginPath();
  ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);
  ctx.fill();
}


if (p.type === "blackAsh") {
  ctx.globalCompositeOperation = "source-over";
  ctx.fillStyle = `rgba(8,7,6,${p.alpha})`;

  ctx.fillRect(
    drawX,
    drawY,
    p.size * 1.4,
    p.size
  );
}

  }

  ctx.restore();
}

function drawVignette() {
  ctx.save();

  const gradient = ctx.createRadialGradient(
    canvas.width / 2,
    canvas.height / 2,
    160,
    canvas.width / 2,
    canvas.height / 2,
    720
  );

  gradient.addColorStop(0, "rgba(0,0,0,0)");
  gradient.addColorStop(1, "rgba(0,0,0,0.38)");

  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  ctx.restore();
}



