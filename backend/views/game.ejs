<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <title>Giants Game</title>
  
<style>
  *{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial, Helvetica, sans-serif;
  }
  
body::before{
  content:"";
  position:fixed;
  inset:0;
  background:
    radial-gradient(circle at center,
    rgba(255,190,90,0.08) 0%,
    rgba(40,60,90,0.12) 35%,
    transparent 70%);
  pointer-events:none;
  z-index:-1;
}

  body{
    background:
    radial-gradient(circle at top, #1f2733 0%, #0d1218 45%, #05070a 100%);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
    flex-direction:column;
    gap:8px;
    overflow:hidden;
  }

  .objective-hud,
  .menu-bar,
  .topbar,
  .help{
    display:none;
  }

  .game-header{
    backdrop-filter:blur(6px);
    width:1200px;
    height:46px;
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    padding:0 14px;
    background:rgba(0,0,0,0.42);
    border:1px solid rgba(215,175,100,0.45);
    box-shadow:0 0 18px rgba(0,0,0,0.45);
  }

  .header-left{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:15px;
  }

  .player-label{
    color:#d9b46a;
    font-weight:bold;
    letter-spacing:.5px;
  }

  .header-center{
    color:#f4d27a;
    font-size:15px;
    font-weight:bold;
    letter-spacing:.6px;
  }

  .header-right{
    display:flex;
    justify-content:flex-end;
    gap:18px;
  }

  .header-right a{
    color:white;
    text-decoration:none;
    font-size:14px;
    font-weight:bold;
  }

  .header-right a:hover{
    color:#f4d27a;
  }

  .control-hint{
    width:1200px;
    font-size:12px;
    color:rgba(255,255,255,0.72);
    padding-left:4px;
    margin-top:-2px;
  }

  canvas{
    background:linear-gradient(to top, #1a1a1a 0%, #101820 55%, #0a1018 100%);
    border:3px solid #2b241b;
    display:block;
    cursor:crosshair;
    box-shadow:
      0 0 0 4px rgba(0,0,0,0.75),
      0 0 35px rgba(0,0,0,0.9);
  }

  #completeSectorBtn{
    font-weight:bold;
    box-shadow:0 0 18px rgba(31,139,255,0.45);
  }
</style>

</head>
<body>
  <div 
  id="gameMeta"
  data-objective-type="<%= sectorData.objectiveType %>"
  data-target-kill-count="<%= sectorData.enemyCount || 0 %>"
  data-target-item-count="<%= sectorData.itemTarget || 0 %>"
  data-spawn-enemy-count="<%= sectorData.objectiveType === 'kill' && Number(sector) !== 10 ? (sectorData.enemyCount || 0) + 3 : (sectorData.enemyCount || 0) %>"
  data-spawn-gas-count="<%= sectorData.objectiveType === 'collect' ? (sectorData.itemTarget || 0) + 2 : 2 %>"
  data-level="<%= level %>"
  data-sector="<%= sector %>"
></div>

  <div class="objective-hud">
  <div>Level <%= level %> - Sector <%= sector %></div>
  <div><%= sectorData.objectiveText %></div>

  <div id="objectiveProgress">
  <% if (sectorData.objectiveType === "reach") { %>
    NOT REACHED
  <% } else { %>
    0 / <%= sectorData.itemTarget || sectorData.enemyCount %>
  <% } %>
</div>

</div>


