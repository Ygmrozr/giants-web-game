function drawGrappleSparks() {
  grappleSparks.forEach(p => {
    const alpha = p.life / p.maxLife;
    const x = p.x - camera.x;
    const y = p.y;

    ctx.save();

    if (p.type === "spark") {
      ctx.globalAlpha = alpha;
      ctx.shadowColor = "rgba(255,55,20,0.95)";
      ctx.shadowBlur = 14;
      ctx.strokeStyle = `rgba(255,80,35,${alpha})`;
      ctx.lineWidth = 2.2;

      ctx.beginPath();
      ctx.moveTo(x, y);
      ctx.lineTo(
        x - p.vx * p.length * 0.5,
        y - p.vy * p.length * 0.5
      );
      ctx.stroke();

      ctx.fillStyle = `rgba(255,220,160,${alpha})`;
      ctx.beginPath();
      ctx.arc(x, y, 2.4 * alpha, 0, Math.PI * 2);
      ctx.fill();
    }

    if (p.type === "smoke") {
      ctx.globalAlpha = alpha * 0.25;
      ctx.fillStyle = "rgba(120,115,110,1)";
      ctx.beginPath();
      ctx.arc(x, y, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    ctx.restore();
  });
}

    function getPlayerImage() {

      if (game.state === "lose" || player.health <= 0) {
  return playerSprites.dead;
}
  if (player.attackTimer > 0) {
    return playerSprites.attack;
  }

  if (!player.onGround) {
    return playerSprites.jump;
  }

  if (Math.abs(player.vx) > 0.5) {
    const runFrames = [
      playerSprites.run1,
      playerSprites.run2,
      playerSprites.run3,
      playerSprites.run4
    ];

    const runIndex = Math.floor(Date.now() / 110) % runFrames.length;
    return runFrames[runIndex];
  }

  return playerSprites.idle;
}

function drawPlayerSprite(img, drawX, drawY, drawWidth, drawHeight, facing) {
  ctx.save();

  if (facing === -1) {
    ctx.scale(-1, 1);
    ctx.drawImage(
      img,
      -drawX - drawWidth,
      drawY,
      drawWidth,
      drawHeight
    );
  } else {
    ctx.drawImage(
      img,
      drawX,
      drawY,
      drawWidth,
      drawHeight
    );
  }

  ctx.restore();
}

function drawPlayer() {
  const img = getPlayerImage();
  const PLAYER_SCALE = 0.84;

  const hitboxX = player.x - camera.x;
  const hitboxY = player.y;

  if (img && img.complete && img.naturalWidth > 0) {
    const drawHeight = player.height * PLAYER_SCALE;
    const drawWidth = drawHeight * (img.naturalWidth / img.naturalHeight);

    const drawX = hitboxX + player.width / 2 - drawWidth / 2;
    const drawY = hitboxY + player.height - drawHeight;

    drawPlayerSprite(
      img,
      drawX,
      drawY,
      drawWidth,
      drawHeight,
      player.facing
    );
  } else {
    ctx.fillStyle = "#2ecc71";
    ctx.fillRect(hitboxX, hitboxY, player.width, player.height);
  }
}

