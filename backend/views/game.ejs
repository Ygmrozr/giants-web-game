  coin: new Image(),
  medkit: new Image(),
  boost: new Image()
};

itemSprites.gas.src = "/images/items/gas.png";
itemSprites.coin.src = "/images/items/coin.png";
itemSprites.medkit.src = "/images/items/medkit.png";
itemSprites.boost.src = "/images/items/boost.png";


    const keys = {};

    function rand(min, max) {
      return Math.random() * (max - min) + min;
    }

    function randInt(min, max) {
      return Math.floor(rand(min, max + 1));
    }

    function rectsCollide(a, b) {
      return (
        a.x < b.x + b.width &&
        a.x + a.width > b.x &&
        a.y < b.y + b.height &&
        a.y + a.height > b.y
      );
    }

    function clamp(value, min, max) {
      return Math.max(min, Math.min(max, value));
    }

    function dist(ax, ay, bx, by) {
      const dx = bx - ax;
      const dy = by - ay;
      return Math.sqrt(dx * dx + dy * dy);
    }

    function getPlayerRect() {
      return {
        x: player.x,
        y: player.y,
        width: player.width,
        height: player.height
      };
    }

    function createTitan(x, minX, maxX, dir = 1) {
      const height = randInt(165, 230);
      const width = Math.floor(height * 0.38);
      const hp = Math.max(3, Math.floor(height / 42));

      return {
        x,
        y: ground.y - height,
        width,
        height,
        spriteWidth: Math.max(80, Math.floor(height * 0.70)),
        spriteHeight: height + 22,
        alive: true,
        dir,
        minX,
        maxX,
        moveSpeed: rand(0.34, 0.54),
        maxHealth: hp,
        health: hp,
        hitCooldown: 0,
        attackCooldown: 0,
        stunTimer: 0,
        attackFlashTimer: 0,
        damage: randInt(6, 12),
        bloodTimer: 0,
        state: "walk",
    frame: 0,
    frameTimer: 0,
    deadTimer: 0,
    drawDead: false,
    faceDir: dir,
bodyHitCount: 0,
rageTimer: 0,
rageDamageCooldown: 0,
stepDustTimer: 0
      };
    }

    const titanSpawnSlots = [
      620, 950, 1280, 1600, 1930,
      2240, 2550, 2860, 3180, 3480
    ];

    const itemSlots = [
  { x: 250, y: 570, type: "ground" },
  { x: 430, y: 570, type: "ground" },

  { x: 610, y: 360, type: "platform" },
  { x: 820, y: 570, type: "ground" },

  { x: 1035, y: 220, type: "platform" },
  { x: 1250, y: 570, type: "ground" },

  { x: 1515, y: 250, type: "platform" },
  { x: 1740, y: 570, type: "ground" },

  { x: 2030, y: 300, type: "platform" },
  { x: 2310, y: 290, type: "platform" },
  { x: 2570, y: 240, type: "platform" },

  { x: 2820, y: 570, type: "ground" },

  { x: 3125, y: 330, type: "platform" },
  { x: 3375, y: 280, type: "platform" },
  { x: 3575, y: 345, type: "platform" }
];


    function createBossTitan() {
      const boss = createTitan(3450, 3300, 3650, -1);

      boss.height = 170;
      boss.width = 75;
      boss.spriteWidth = 135;
      boss.spriteHeight = 210;
      boss.y = ground.y - boss.height;
      boss.maxHealth = 12 + currentBattle * 3;
      boss.health = boss.maxHealth;
      boss.damage = 15 + currentBattle * 2;
      boss.moveSpeed = 0.55 + currentBattle * 0.06;
      boss.isBoss = true;

      return boss;
    }

    function spawnTitansBySector() {
      titans.length = 0;

      if (currentSectorNumber === 10) {
        titans.push(createBossTitan());
        return;
      }

      for (let i = 0; i < spawnEnemyCount; i++) {
        const sectorOffset = ((currentBattle * 70) + (currentSectorNumber * 45)) % 180;
        const x = (titanSpawnSlots[i] || 650 + i * 290) + sectorOffset;

        const minX = Math.max(500, x - 90);
        const maxX = Math.min(WORLD.width - 120, x + 120);
        const dir = i % 2 === 0 ? 1 : -1;

        const titan = createTitan(x, minX, maxX, dir);
        titan.frame = 0;
        titan.frameTimer = 0;
        titan.state = "walk";

        if (currentBattle === 2) {
          titan.moveSpeed *= 1.15;
        }

        if (currentBattle === 3) {
          titan.maxHealth += 3;
          titan.health = titan.maxHealth;
          titan.damage += 5;
          titan.moveSpeed *= 1.05;
        }

        if (currentBattle >= 4) {
          titan.maxHealth += 1;
          titan.health = titan.maxHealth;
          titan.damage += 3;
        }

        if (currentBattle === 5) {
          titan.maxHealth += 2;
          titan.health = titan.maxHealth;
          titan.damage += 4;
          titan.moveSpeed *= 1.08;
        }

        titans.push(titan);
      }
    }

    function createItem(kind, slotIndex) {
  const offset = (currentBattle * 2 + currentSectorNumber * 3) % itemSlots.length;
  const slot = itemSlots[(slotIndex + offset) % itemSlots.length];

      const base = {
        x: slot.x,
        y: slot.y,
        width: 18,
        height: 18,
        collected: false,
        kind
      };

      if (kind === "gas") {
        return { ...base, score: 20, gas: 40 };
      }

      if (kind === "medkit") {
        return { ...base, score: 25, heal: 35 };
      }

      if (kind === "boost") {
        return { ...base, score: 180 };
      }

      return { ...base, score: 50, medals: 1 };
    }


    function spawnItemsBySector() {
  items.length = 0;

  let slotIndex = 0;
  const gasCount = objectiveType === "collect" ? spawnGasCount : 2;

  for (let i = 0; i < gasCount; i++) {
    items.push(createItem("gas", slotIndex++));
  }

if (currentSectorNumber % 2 === 0 || currentSectorNumber === 10) {
  items.push(createItem("medkit", slotIndex++));
}

  if (currentSectorNumber % 3 === 0 || currentSectorNumber === 10) {
  items.push(createItem("boost", slotIndex++));
}

  if (objectiveType === "collect") {
    for (let i = 0; i < 4; i++) {
      items.push(createItem("score", slotIndex++));
    }
  }

  if (objectiveType !== "collect") {
    const coinCount = 4 + currentBattle + Math.floor(currentSectorNumber / 3);

    for (let i = 0; i < coinCount; i++) {
      items.push(createItem("score", slotIndex++));
    }
  }
}

    function setupSectorContent() {
      spawnTitansBySector();
      spawnItemsBySector();
    }


    const titans = [];

    const items = [];

    const finish = {
      x: 3820,
      y: 330,
      width: 60,
      height: 160
    };

    let killScore = 0;
    let itemScore = 0;
    const bloodEffects = [];
    let speedLines = [];
    let boostTrails = [];
    let stompDusts = [];
    let grappleSparks = [];
    let atmosphereParticles = [];
    let titanKillCount = 0;
    let itemCollectedCount = 0;
    let collectedSupplyCount = 0;
    let collectedMedalCount = 0;
    let scoreSaved = false;
    let lastUnlockedTitle = null;
    let finalStrikeTimer = 0;
let screenShakeTimer = 0;

    function spawnBlood(x, y, count = 10) {
  for (let i = 0; i < count; i++) {
    bloodEffects.push({
      x,
      y,
      vx: rand(-3.8, 3.8),
      vy: rand(-4.2, -0.8),
      life: randInt(18, 34),
      maxLife: 34,
      size: rand(2, 5),
      type: Math.random() < 0.65 ? "drop" : "streak"
    });
  }
}

function spawnGrappleSpark(x, y) {
  grappleSparks.length = 0;

  for (let i = 0; i < 10; i++) {
    const angle = rand(-Math.PI, Math.PI);

    grappleSparks.push({
      x,
      y,
      vx: Math.cos(angle) * rand(1.8, 5.2),
      vy: Math.sin(angle) * rand(1.2, 3.8),
      length: rand(7, 16),
      life: randInt(8, 14),
      maxLife: 14,
      type: "spark"
    });
  }

  for (let i = 0; i < 4; i++) {
    grappleSparks.push({
      x,
      y,
      vx: rand(-0.5, 0.5),
      vy: rand(-0.8, -0.2),
      size: rand(4, 8),
      life: randInt(12, 18),
      maxLife: 18,
      type: "smoke"
    });
  }
}

function initAtmosphereParticles() {
  atmosphereParticles = [];

  // Az sayıda yumuşak toz bulutu
  for (let i = 0; i < 10; i++) {
    atmosphereParticles.push({
      type: "dust",
      x: rand(0, WORLD.width),
      y: rand(120, canvas.height - 80),
      size: rand(18, 38),
      speedX: rand(-0.08, 0.04),
      speedY: rand(-0.02, 0.03),
      alpha: rand(0.06, 0.13)
    });
  }

  // Turuncu köz / ateş parçacıkları
  for (let i = 0; i < 90; i++) {
    atmosphereParticles.push({
      type: "ember",
      x: rand(0, WORLD.width),
      y: rand(40, canvas.height - 40),
      size: rand(1.2, 2.8),
