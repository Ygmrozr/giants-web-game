function drawComboCounter() {
  if (comboTimer <= 0 || comboDisplayTimer <= 0 || comboCount < 1) return;

  const timerRatio = Math.max(0, comboTimer / 180);
  const fadeIn = Math.min(1, comboDisplayTimer / 18);
  const fadeOut = Math.min(1, comboTimer / 30);
  const alpha = Math.min(fadeIn, fadeOut);

  const popScale = comboPopTimer > 0
    ? 1 + comboPopTimer * 0.018
    : 1;

  let title = "TITAN KILL";

  if (comboCount >= 5) {
    title = "PERFECT STRIKE";
  } else if (comboCount >= 3) {
    title = "CHAIN ATTACK";
  } else if (comboCount >= 2) {
    title = "KILL COMBO";
  }

  ctx.save();

  ctx.translate(canvas.width / 2, 92);
  ctx.scale(popScale, popScale);
  ctx.textAlign = "center";

  // Dış glow
  const glow = ctx.createRadialGradient(
  0,
  0,
  0,
  0,
  0,
  210
);
  glow.addColorStop(0, `rgba(255,55,25,${0.24 * alpha})`);
  glow.addColorStop(0.45, `rgba(255,165,55,${0.13 * alpha})`);
  glow.addColorStop(1, "rgba(0,0,0,0)");

  ctx.fillStyle = glow;
  ctx.beginPath();
  ctx.arc(0, 0, 210, 0, Math.PI * 2);
  ctx.fill();

  // Ana panel
  ctx.fillStyle = `rgba(0,0,0,${0.46 * alpha})`;
  ctx.fillRect(-170, -38, 340, 82);

  ctx.strokeStyle = `rgba(255,210,120,${0.85 * alpha})`;
  ctx.lineWidth = 1.7;
  ctx.strokeRect(-170, -38, 340, 82);

  // Üst dekoratif çizgiler
  ctx.strokeStyle = `rgba(255,80,35,${0.9 * alpha})`;
  ctx.lineWidth = 2;

  ctx.beginPath();
  ctx.moveTo(-125, -47);
  ctx.lineTo(-35, -47);
  ctx.stroke();

  ctx.beginPath();
  ctx.moveTo(35, -47);
  ctx.lineTo(125, -47);
  ctx.stroke();

  // Başlık
  ctx.fillStyle = `rgba(255,220,145,${alpha})`;
  ctx.font = "bold 15px Arial";
  ctx.fillText(title, 0, -13);

  // Combo sayısı
  ctx.shadowColor = "rgba(255,50,20,0.9)";
  ctx.shadowBlur = 14;
  ctx.fillStyle = `rgba(255,65,45,${alpha})`;
  ctx.font = "bold 46px Arial";
  ctx.fillText(`x${comboCount}`, 0, 30);

  ctx.shadowBlur = 0;

  // Best combo küçük bilgi
  ctx.fillStyle = `rgba(255,255,255,${0.65 * alpha})`;
  ctx.font = "bold 11px Arial";
  ctx.fillText(`BEST x${bestCombo}`, 0, 43);

  // Süre barı
  ctx.fillStyle = `rgba(255,255,255,${0.16 * alpha})`;
  ctx.fillRect(-120, 53, 240, 4);

  ctx.fillStyle = `rgba(255,95,35,${0.95 * alpha})`;
  ctx.fillRect(-120, 53, 240 * timerRatio, 4);

  ctx.restore();

  // Küçük kırmızı/turuncu parçacıklar
  for (const p of comboParticles) {
    const pAlpha = Math.max(0, p.life / p.maxLife);

    ctx.save();
    ctx.globalAlpha = pAlpha;
    ctx.fillStyle = "rgba(255,90,35,1)";
    ctx.beginPath();
    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }
}

    function updateTitanAnimation(titan) {
  if (!titan.alive) {
    titan.state = "dead";
    return;
  }

  if (titan.hitCooldown > 0 || titan.stunTimer > 0) {
    titan.state = "hurt";
    return;
  }

  if (titan.rageTimer > 0 || titan.attackFlashTimer > 0 || titan.attackCooldown > 28) {
    titan.state = "attack";
    return;
  }

  titan.state = "walk";
  titan.frameTimer++;

  if (titan.state === "walk" && titan.alive) {
  if (titan.frame === 1 || titan.frame === 3) {
    playSfx("titanStep", 0.22, 450);
  }
}

  if (titan.frameTimer >= 30) {
    titan.frameTimer = 0;
    titan.frame = (titan.frame + 1) % titanWalkFrames.length;
  }
}

function getFemaleTitan() {
  return titans.find(titan => titan.isFemaleTitan);
}

function updateFemaleTitanChase(titan) { 
  if (!titan || !titan.alive) return;

  if (titan.x < 520) titan.dir = 1;
  if (titan.x > WORLD.width - 520) titan.dir = -1;

  titan.faceDir = titan.dir;
  titan.x += titan.dir * titan.moveSpeed * 1.15;

  titan.state = "walk";
  titan.frameTimer++;

  if (titan.frameTimer >= 35) {
    titan.frameTimer = 0;
    titan.frame = (titan.frame + 1) % femaleTitanWalkFrames.length;
  }
}

function updateFemaleTitanPush(titan) {
  if (!isRoofChaseSector) return;
  if (!titan || !titan.alive) return;
  if (femalePushCooldown > 0) return;

  const playerCenterX = player.x + player.width / 2;
  const titanCenterX = titan.x + titan.width / 2;
  const distance = Math.abs(playerCenterX - titanCenterX);

  const playerOnGround = player.y + player.height >= ground.y - 6;

  if (distance < 190 && playerOnGround) {
    const pushDir = playerCenterX < titanCenterX ? -1 : 1;

    player.vx = pushDir * 12;
    player.vy = -6;
    player.grappling = false;
    player.grappleTarget = null;

    if (activeCivilian && activeCivilian.following) {
      activeCivilian.health--;

      if (activeCivilian.health <= 0) {
killCivilian("Civilian died!");      }
    }

    damagePlayer(8, titanCenterX);

    screenShakeTimer = 14;
    femalePushCooldown = 90;
  }
}

function getFemaleDifficulty() {
  const setting = rescueSettingsBySector[currentSectorNumber];
  return setting ? setting.difficulty : 1;
}


function getFemaleRescueSetting() {
  return rescueSettingsBySector[currentSectorNumber] || rescueSettingsBySector[1];
}

function getFemaleAttackCooldown() {
  const setting = getFemaleRescueSetting();
  return setting.cooldownAfterAttack || 420;
}

function startFemaleCivilianAttack(titan) {
  const setting = getFemaleRescueSetting();

  if (setting.attacksEnabled === false) return;

  femaleTargetCivilian = true;
  civilianDangerMaxTimer = Math.max(180, (setting.warningTime || 150) + (setting.chargeTime || 150));
  civilianDangerTimer = civilianDangerMaxTimer;

  femaleAttackMode = "warning";

  femaleAttackTimer = setting.warningTime || 150;
  femaleAttackHits = 0;
  femaleAttackHitsNeeded = setting.hitsNeeded || 1;

  titan.state = "attack";
  titan.attackFlashTimer = femaleAttackTimer;
}

function startFemalePlayerAttack(titan) {
  const setting = getFemaleRescueSetting();

  if (setting.attacksEnabled === false) return;

  femaleTargetCivilian = false;
  civilianDangerTimer = 0;

  femaleAttackMode = "warning";

if (!titan.attackRageSoundPlayed) {
  playSfx("bossRage", 0.65, 3000);
  titan.attackRageSoundPlayed = true;
}

femaleAttackTimer = Math.max(90, setting.warningTime || 130);
  femaleAttackHits = 0;
  femaleAttackHitsNeeded = setting.hitsNeeded || 1;

  titan.state = "attack";
  titan.attackFlashTimer = femaleAttackTimer;
}

function updateFemaleTitanSpecialAttack(titan) {
  if (!isRoofChaseSector) return;
  if (!titan || !titan.alive) return;

  const playerCenterX = player.x + player.width / 2;
  const titanCenterX = titan.x + titan.width / 2;
  const distanceToPlayer = Math.abs(playerCenterX - titanCenterX);

 const civilianNeedsProtection = false;

  const setting = getFemaleRescueSetting();

  if (setting.attacksEnabled === false) {
    return;
  }

  if (femaleAttackMode === "idle") {
    if (civilianNeedsProtection && femaleAttackCooldown <= 0) {
      startFemaleCivilianAttack(titan);
    } else if (
  femaleAttackCooldown <= 0 &&
  distanceToPlayer > 360 &&
  distanceToPlayer < 900 &&
  currentSectorNumber >= 3
) {
  startFemalePlayerAttack(titan);
}
  }

  if (femaleAttackMode === "warning") {
    femaleAttackTimer--;

    const targetX = playerCenterX;

    titan.faceDir = targetX < titanCenterX ? -1 : 1;
    titan.dir = titan.faceDir;
    titan.state = "attack";
    titan.attackFlashTimer = 12;

    if (femaleAttackTimer <= 0) {
      femaleAttackMode = "charge";
      femaleAttackTimer = setting.chargeTime || 160;
    }
  }

  if (femaleAttackMode === "charge") {
    femaleAttackTimer--;

    const targetX =
      femaleTargetCivilian && activeCivilian
        ? activeCivilian.x + activeCivilian.width / 2
        : playerCenterX;

    const dir = targetX < titanCenterX ? -1 : 1;
    titan.dir = dir;
    titan.faceDir = dir;
    titan.x += dir * titan.moveSpeed * (setting.chargeSpeedMultiplier || 1.7);

    if (titan.x > femaleTitanSafeZoneStopX) {
  titan.x = femaleTitanSafeZoneStopX;
  titan.dir = -1;
  titan.faceDir = -1;
  titan.state = "idle";
  femaleAttackMode = "retreat";
  femaleAttackTimer = 80;
  femaleAttackCooldown = getFemaleAttackCooldown();
  femaleTargetCivilian = false;
  civilianDangerTimer = 0;
  return;
}

    titan.state = "attack";
    titan.attackFlashTimer = 10;

    const newTitanCenterX = titan.x + titan.width / 2;

    if (activeCivilian && !activeCivilian.rescued && !activeCivilian.dead) {
  const civilianCenterX = activeCivilian.x + activeCivilian.width / 2;
  const civilianClose = Math.abs(civilianCenterX - newTitanCenterX) < 85;

  if (civilianClose) {
    activeCivilian.health--;

    if (activeCivilian.following) {
      activeCivilian.following = false;
      activeCivilian.dropped = true;
      activeCivilian.vy = 0;
      activeCivilian.fallStartY = activeCivilian.y;
    }

    if (activeCivilian.health <= 0) {
      killCivilian("Female Titan killed the civilian!");
    } else {
      screenShakeTimer = 10;
    }
  }
}

    if (Math.abs(playerCenterX - newTitanCenterX) < 120) {
  damagePlayer(18, newTitanCenterX);
  femaleAttackMode = "retreat";
  femaleAttackTimer = 80;
  femaleAttackCooldown = getFemaleAttackCooldown();
  screenShakeTimer = 16;
}

    if (femaleAttackTimer <= 0) {
      femaleAttackMode = "retreat";
      femaleAttackTimer = 80;
      femaleAttackCooldown = getFemaleAttackCooldown();
    }
  }

  if (femaleAttackMode === "retreat") {
    femaleAttackTimer--;

    titan.dir = player.x < titan.x ? 1 : -1;
    titan.faceDir = titan.dir;
    titan.x += titan.dir * titan.moveSpeed * 1.6;
    if (titan.x > femaleTitanSafeZoneStopX) {
  titan.x = femaleTitanSafeZoneStopX;
  titan.dir = -1;
  titan.faceDir = -1;
}

    if (femaleAttackTimer <= 0) {
  femaleAttackMode = "idle";
  femaleTargetCivilian = false;
  civilianDangerTimer = 0;
  titan.attackRageSoundPlayed = false;
  titan.state = "walk";
}
  }
}


function drawCrystalTransformEffect(x, y) {
  if (crystalEffectTimer <= 0) return;

  const alpha = Math.min(1, crystalEffectTimer / 45);
  const pulse = 1 + Math.sin(crystalEffectTimer * 0.25) * 0.08;

  ctx.save();
  ctx.globalCompositeOperation = "screen";

  // Küçük kristal glow
  const glow = ctx.createRadialGradient(x, y - 92, 5, x, y - 92, 85 * pulse);
  glow.addColorStop(0, `rgba(255,255,255,${0.55 * alpha})`);
  glow.addColorStop(0.35, `rgba(150,230,255,${0.32 * alpha})`);
  glow.addColorStop(1, "rgba(80,160,255,0)");

  ctx.fillStyle = glow;
  ctx.beginPath();
  ctx.arc(x, y - 92, 85 * pulse, 0, Math.PI * 2);
  ctx.fill();

  // İnce kristal çizgileri
  for (let i = 0; i < 6; i++) {
    const a = -Math.PI / 2 + (i - 2.5) * 0.28;
    const len = 28 + (i % 2) * 12;

    const sx = x + Math.cos(a) * 18;
    const sy = y - 92 + Math.sin(a) * 18;
    const ex = x + Math.cos(a) * len;
    const ey = y - 92 + Math.sin(a) * len;

    ctx.strokeStyle = `rgba(210,245,255,${0.65 * alpha})`;
    ctx.lineWidth = 1.4;
    ctx.beginPath();
    ctx.moveTo(sx, sy);
    ctx.lineTo(ex, ey);
    ctx.stroke();
  }

  // Küçük yıldız pırıltıları
  for (let i = 0; i < 5; i++) {
    const px = x + Math.cos(i * 1.7 + crystalEffectTimer * 0.08) * (32 + i * 6);
    const py = y - 92 + Math.sin(i * 1.3 + crystalEffectTimer * 0.06) * (22 + i * 3);
    const s = 4 + (i % 2) * 2;

    ctx.strokeStyle = `rgba(255,255,255,${0.8 * alpha})`;
    ctx.lineWidth = 1;

    ctx.beginPath();
    ctx.moveTo(px - s, py);
    ctx.lineTo(px + s, py);
    ctx.moveTo(px, py - s);
    ctx.lineTo(px, py + s);
    ctx.stroke();
  }

  ctx.restore();

  crystalEffectTimer--;
}


function updateChaseObjective() {
  if (!isRoofChaseSector || objectiveCompleted) return;

  // Battle 3 sectors 1-4 are civilian rescue missions.
  // Reaching the end of the map should not complete the objective anymore.
  if (currentBattle === 3 && currentSectorNumber <= 4) {
    return;
  }

  const finalRoof = platformSlots[platformSlots.length - 1];

  if (player.x >= finalRoof.x - 40) {
    objectiveCompleted = true;
    objectiveCompleteNoticeTimer = 180;
    playSfx("sectorComplete", 0.55, 2000);

    const completeBtn = document.getElementById("completeSectorBtn");
    if (completeBtn) {
      completeBtn.style.display = "block";
    }
  }
}


function updateFemaleFinalSequence() {
  if (!isFemaleTitanFinalSector) return;

  const femaleTitan = getFemaleTitan();
  if (!femaleTitan) return;

  if (femaleFinalPhase === "annieLying") {
    annieCrystalTimer--;

    if (annieCrystalTimer <= 0) {
      femaleFinalPhase = "crystal";
      crystalEffectTimer = 150;
      playSfx("crystalTransform", 0.65, 3000);

      objectiveCompleted = true;
      objectiveCompleteNoticeTimer = 180;

      const completeBtn = document.getElementById("completeSectorBtn");
      if (completeBtn) {
        completeBtn.style.display = "block";
      }

      updateObjectiveProgress();
    }
  }
}

function handleFemaleFinalExtractionAttack() {
  if (!isFemaleTitanFinalSector) return false;
  if (femaleFinalPhase !== "fallenTitan") return false;

  const femaleTitan = getFemaleTitan();
  if (!femaleTitan) return true;

  const nape = getTitanNapeZone(femaleTitan);

  const playerCenterX = player.x + player.width / 2;
  const playerBottomY = player.y + player.height;

  const nearNape =
    Math.abs(playerCenterX - (nape.x + nape.width / 2)) < 170 &&
    playerBottomY >= ground.y - 140;

  if (!nearNape) return true;

  femaleExtractProgress++;
  player.attackTimer = 8;
  screenShakeTimer = 6;

  if (femaleExtractProgress >= 8) {
  femaleFinalPhase = "annieLying";
  annieCrystalTimer = 150;
  crystalEffectTimer = 150;
  femaleTitan.drawDead = false;
}

  return true;
}


function isSpecialBoss(titan) {
  return titan.isArmoredTitan || titan.isBeastTitan;
}

function updateSpecialBossMovement(titan) {
  // Sadece gerçek sersemleme sırasında hareket etme.
  // Kısa hitCooldown artık bossları kilitlemez; böylece sürekli vurup
  // saldırılarını iptal etmek mümkün olmaz.
  if (titan.stunTimer > 0) {
    titan.state = "hurt";
    return;
  }

  if (titan.isBeastTitan) {
    // Maymun Dev taş atmaz ve oyuncuyu sürekli takip etmez.
    // Dişi Dev gibi haritanın iki ucu arasında sola-sağa devriye gezer.
    if (titan.specialAttackMode === "warning") {
      titan.state = "attack";
      titan.attackFlashTimer = 12;
      return;
    }

    if (titan.specialAttackMode === "charge") {
      const playerCenterX = player.x + player.width / 2;
      const titanCenterX = titan.x + titan.width / 2;

      titan.dir = playerCenterX < titanCenterX ? -1 : 1;
      titan.faceDir = titan.dir;
      titan.state = "attack";
      titan.x += titan.dir * titan.moveSpeed * 3.45;

      if (titan.chargeDamageCooldown > 0) {
        titan.chargeDamageCooldown--;
      }

      const titanRect = {
        x: titan.x,
        y: titan.y,
        width: titan.width,
        height: titan.height
      };

      if (
        rectsCollide(getPlayerRect(), titanRect) &&
        titan.chargeDamageCooldown <= 0 &&
        !player.grabbed
      ) {
        damagePlayer(titan.damage + 8, titan.x + titan.width / 2);
        screenShakeTimer = Math.max(screenShakeTimer, 13);
        titan.chargeDamageCooldown = 90;
        titan.chargeTouchedPlayer = true;
        titan.specialAttackMode = "idle";
        titan.specialAttackCooldown = 240;
        titan.state = "walk";
      }

      titan.x = clamp(titan.x, 90, WORLD.width - 160);
      return;
    }

    if (titan.x <= titan.minX) titan.dir = 1;
    if (titan.x >= titan.maxX) titan.dir = -1;

    titan.faceDir = titan.dir;
    titan.x += titan.dir * titan.moveSpeed * 1.15;
    titan.x = clamp(titan.x, titan.minX, titan.maxX);
    titan.state = "walk";
    return;
  }

  // Zırhlı Dev her zaman oyuncuya yönelir.
  const playerCenterX = player.x + player.width / 2;
  const titanCenterX = titan.x + titan.width / 2;

  titan.dir = playerCenterX < titanCenterX ? -1 : 1;
  titan.faceDir = titan.dir;

  if (titan.specialAttackMode === "warning") {
    titan.state = "attack";
    titan.attackFlashTimer = 12;
    return;
  }

  if (titan.specialAttackMode === "charge") {
    titan.state = "attack";
    titan.x += titan.dir * titan.moveSpeed * 3.2;

    if (titan.chargeDamageCooldown > 0) {
      titan.chargeDamageCooldown--;
    }

    const titanRect = {
      x: titan.x,
      y: titan.y,
      width: titan.width,
      height: titan.height
    };

    if (
      rectsCollide(getPlayerRect(), titanRect) &&
      titan.chargeDamageCooldown <= 0 &&
      !player.grabbed
    ) {
      damagePlayer(30, titan.x + titan.width / 2);
      screenShakeTimer = Math.max(screenShakeTimer, 14);
      titan.chargeDamageCooldown = 90;
      titan.chargeTouchedPlayer = true;
      titan.specialAttackMode = "idle";
      titan.specialAttackCooldown = 250;
      titan.state = "walk";
    }

    titan.x = clamp(titan.x, 90, WORLD.width - 160);
    return;
  }

  titan.state = "walk";
  titan.x += titan.dir * titan.moveSpeed * 0.95;
  titan.x = clamp(titan.x, 90, WORLD.width - 160);
}

function updateArmoredTitanSpecialAttack(titan) {
  if (!titan.alive || titan.stunTimer > 0) return;

  if (titan.specialAttackCooldown > 0) {
    titan.specialAttackCooldown--;
  }

  if (titan.specialAttackMode === "idle") {
    if (titan.specialAttackCooldown <= 0) {
      titan.specialAttackMode = "warning";
      titan.specialAttackTimer = 95;
      titan.attackFlashTimer = 95;

      bossSpecialWarning = {
        text: "ARMORED TITAN CHARGE!",
        timer: 95,
        type: "charge"
      };

      playSfx("bossRage", 0.6, 2500);
    }

    return;
  }

  if (titan.specialAttackMode === "warning") {
    titan.specialAttackTimer--;

    if (titan.specialAttackTimer <= 0) {
      titan.specialAttackMode = "charge";
      // Oyuncuya değene kadar hızlı gelmeye çalışır; süre sadece güvenlik sınırı.
      titan.specialAttackTimer = 220;
      titan.chargeDamageCooldown = 0;
      titan.chargeTouchedPlayer = false;
      screenShakeTimer = Math.max(screenShakeTimer, 8);
    }

    return;
  }

  if (titan.specialAttackMode === "charge") {
    titan.specialAttackTimer--;

    if (titan.specialAttackTimer <= 0) {
      titan.specialAttackMode = "idle";
      titan.specialAttackCooldown = 250;
      titan.state = "walk";
    }
  }
}

function updateBeastTitanSpecialAttack(titan) {
  if (!titan.alive || titan.stunTimer > 0) return;

  if (titan.specialAttackCooldown > 0) {
    titan.specialAttackCooldown--;
  }

  if (titan.specialAttackMode === "idle") {
    if (titan.specialAttackCooldown <= 0) {
      titan.specialAttackMode = "warning";
      titan.specialAttackTimer = 85;
      titan.chargeDamageCooldown = 0;
      titan.chargeTouchedPlayer = false;
      titan.attackFlashTimer = 85;

      bossSpecialWarning = {
        text: "BEAST TITAN CHARGE!",
        timer: 85,
        type: "beast"
      };

      playSfx("bossRage", 0.55, 2500);
    }

    return;
  }

  if (titan.specialAttackMode === "warning") {
    titan.specialAttackTimer--;
    titan.state = "attack";
    titan.attackFlashTimer = 12;

    if (titan.specialAttackTimer <= 0) {
      titan.specialAttackMode = "charge";
      // Oyuncuya değene kadar hızlı gelir; süre sadece güvenlik sınırı.
      titan.specialAttackTimer = 220;
      titan.chargeDamageCooldown = 0;
      titan.chargeTouchedPlayer = false;
      screenShakeTimer = Math.max(screenShakeTimer, 8);
    }

    return;
  }

  if (titan.specialAttackMode === "charge") {
    titan.specialAttackTimer--;
    titan.state = "attack";
    titan.attackFlashTimer = 12;

    if (titan.specialAttackTimer <= 0) {
      titan.specialAttackMode = "idle";
      titan.specialAttackCooldown = 240;
      titan.state = "walk";
    }
  }
}

function updateTitans() {
  if (game.state !== "playing") return;

  titans.forEach(titan => {
    if (titan.isFemaleTitan && isFemaleTitanChaseSector) {
  updateFemaleTitanChase(titan);
  return;
}
    if (!titan.alive) {
  if (
    titan.isFemaleTitan &&
    isFemaleTitanFinalSector &&
    femaleFinalPhase === "fallenTitan"
  ) 
  {
    titan.drawDead = true;
    titan.deadTimer = 999999;
    return;
  }

  if (titan.deadTimer > 0) {
  titan.deadTimer--;
  titan.drawDead = true;
} else {
  if (!titan.steamSpawned) {
    spawnTitanSteam(titan);
    titan.steamSpawned = true;
  }

  titan.drawDead = false;
  titan.removeFromGame = true;
}

return;
}

    updateTitanAnimation(titan);

    if (isSpecialBoss(titan)) {
      // Önce oyuncunun vuruşunu işle. Eski akışta buradaki erken return
      // nedeniyle Zırhlı ve Maymun Dev hiç hasar almıyordu.
      if (player.attackTimer > 0) {
        attackTitanIfPossible(titan);
      }

      if (!titan.alive) return;

      updateSpecialBossMovement(titan);

      if (titan.isArmoredTitan) {
        updateArmoredTitanSpecialAttack(titan);
      }

      if (titan.isBeastTitan) {
        updateBeastTitanSpecialAttack(titan);
      }

      // Zırhlı ve Maymun Dev oyuncuya ulaştığında normal temas saldırısı da yapabilir.
      if ((titan.isArmoredTitan || titan.isBeastTitan) && titan.stunTimer <= 0) {
        const titanRect = {
          x: titan.x,
          y: titan.y,
          width: titan.width,
          height: titan.height
        };

        if (
          rectsCollide(getPlayerRect(), titanRect) &&
          titan.specialAttackMode !== "warning" &&
          titan.specialAttackMode !== "charge" &&
          titan.attackCooldown <= 0
        ) {
          damagePlayer(titan.damage, titan.x + titan.width / 2);
          titan.attackCooldown = titan.isArmoredTitan ? 55 : 65;
          titan.attackFlashTimer = 12;
        }
      }

      return;
    }


    if (
  titan.isBoss &&
  !titan.rageSoundPlayed &&
  titan.health <= titan.maxHealth * 0.3
) {
  playSfx("bossRage", 0.6, 3000);
  titan.rageSoundPlayed = true;
}


    if (titan.stunTimer <= 0) {
      const playerCenterX = player.x + player.width / 2;
      const titanCenterX = titan.x + titan.width / 2;

      if (titan.alive && titan.state === "walk") {
        titan.stepDustTimer++;

        if (titan.stepDustTimer >= (titan.isBoss ? 18 : 32)) {
          titan.stepDustTimer = 0;

          stompDusts.push({
  x: titan.x + titan.width / 2,
  y: ground.y - 18,
  life: titan.isBoss ? 24 : 18,
  size: titan.isBoss ? rand(18, 30) : rand(12, 22),
  vx: rand(-0.35, 0.35),
vy: rand(-0.25, -0.05)
});

          if (titan.isBoss) {
            screenShakeTimer = Math.max(screenShakeTimer, 5);
          }
        }
      }

      if (titan.rageTimer > 0) {
        titan.dir = playerCenterX < titanCenterX ? -1 : 1;
        titan.faceDir = titan.dir;

        titan.x += titan.dir * titan.moveSpeed * 1.25;

        const closeEnoughForRageDamage = Math.abs(playerCenterX - titanCenterX) < 105;

        if (
          currentBattle >= 5 &&
          closeEnoughForRageDamage &&
          titan.rageDamageCooldown <= 0 &&
          !player.grabbed
        ) {
          damagePlayer(8, titan.x + titan.width / 2);
          titan.rageDamageCooldown = 75;
        }

        const closeEnoughToGrab = Math.abs(playerCenterX - titanCenterX) < 95;

        if (
          titan.isBoss &&
          closeEnoughToGrab &&
          titan.attackCooldown <= 0 &&
          !player.grabbed &&
          Math.random() < 0.35
        ) {
          player.grabbed = true;
          player.grabbedBy = titan;
          if (!titan.grabRageSoundPlayed) {
  playSfx("bossRage", 0.6, 3000);
  titan.grabRageSoundPlayed = true;
}
          player.escapeProgress = 0;
          player.escapeTimer = 120;

          titan.attackCooldown = 80;
          titan.attackFlashTimer = 20;
        }
      } else {
        titan.x += titan.dir * titan.moveSpeed;

        if (titan.x <= titan.minX) titan.dir = 1;
        if (titan.x >= titan.maxX) titan.dir = -1;
      }
    }

    titan.faceDir = titan.dir;

    if (player.attackTimer > 0) {
      attackTitanIfPossible(titan);
    }

    const titanRect = {
      x: titan.x,
      y: titan.y,
      width: titan.width,
      height: titan.height
    };

    if (rectsCollide(getPlayerRect(), titanRect)) {
      if (titan.stunTimer <= 0 && titanCanAttackPlayer(titan) && titan.attackCooldown <= 0) {
        damagePlayer(titan.damage, titan.x + titan.width / 2);
        titan.attackCooldown = titan.rageTimer > 0 ? 120 : 40;
        titan.attackFlashTimer = 12;
      }
    }
    });

  for (let i = titans.length - 1; i >= 0; i--) {
    if (titans[i].removeFromGame) {
      titans.splice(i, 1);
    }
  }
}




function isCivilianInSafeZone(civilian) {
  if (!civilian) return false;

  return (
    civilian.x + civilian.width > civilianSafeZoneX &&
    civilian.x < civilianSafeZoneX + civilianSafeZoneWidth &&
    civilian.y + civilian.height >= ground.y - 6
  );
}

function rescueActiveCivilian() {
  if (!activeCivilian || activeCivilian.rescued) return;

  rescuedCivilians.push({
    ...activeCivilian,
    x: civilianSafeZoneX + 45 + rescuedCivilians.length * 38,
    y: ground.y - activeCivilian.height,
    following: false,
    dropped: false,
    rescued: true,
    vx: 0,
    vy: 0,
    frame: 0,
    frameTimer: 0
  });

  rescuedCivilianCount++;

  activeCivilian = null;

  updateObjectiveProgress();

  if (rescuedCivilianCount >= rescueTarget) {
    objectiveCompleted = true;
    objectiveCompleteNoticeTimer = 180;

    const completeBtn = document.getElementById("completeSectorBtn");
    if (completeBtn) {
      completeBtn.style.display = "block";
    }

    return;
  }

  setTimeout(() => {
    spawnRescueCivilian();
  }, 700);
}


