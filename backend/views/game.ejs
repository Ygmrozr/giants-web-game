        activeCivilian.y + activeCivilian.height >= p.y &&
        activeCivilian.y + activeCivilian.height <= p.y + 18
      ) {
        const fallDistance = activeCivilian.y - activeCivilian.fallStartY;

activeCivilian.y = p.y - activeCivilian.height;
activeCivilian.vy = 0;

if (fallDistance > 120) {
  activeCivilian.health--;
}

activeCivilian.fallStartY = activeCivilian.y;

if (activeCivilian.health <= 0) {
killCivilian("Civilian died!");}
      }
    }
  }

  const femaleTitan = getFemaleTitan();

  if (
    femaleTitan &&
