function updateAtmosphereParticles() {
  for (const p of atmosphereParticles) {
    p.x += p.speedX;
    p.y += p.speedY;

    if (p.type === "ember") {
      p.flicker += 0.18;
      p.y += Math.sin(p.flicker) * 0.15;
    }

    if (p.x < 0) p.x = WORLD.width;
    if (p.x > WORLD.width) p.x = 0;

    if (p.y < 20) p.y = canvas.height - 40;
    if (p.y > canvas.height - 20) p.y = 40;
  }
}

function drawAtmosphereParticles() {
  ctx.save();

  for (const p of atmosphereParticles) {
    const drawX = p.x - camera.x;
    const drawY = p.y;

    if (drawX < -60 || drawX > canvas.width + 60) continue;

    if (p.type === "dust") {
      ctx.globalCompositeOperation = "screen";

      const gradient = ctx.createRadialGradient(
        drawX,
        drawY,
        0,
        drawX,
        drawY,
        p.size
      );

      gradient.addColorStop(0, `rgba(210,150,75,${p.alpha})`);
      gradient.addColorStop(0.45, `rgba(130,90,55,${p.alpha * 0.45})`);
      gradient.addColorStop(1, "rgba(80,50,30,0)");

      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    if (p.type === "ember") {
  const flickerAlpha = p.alpha * (0.75 + Math.sin(p.flicker) * 0.15);

  ctx.globalCompositeOperation = "screen";
  ctx.fillStyle = `rgba(255,95,25,${flickerAlpha})`;

  ctx.beginPath();
  ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);
  ctx.fill();
}


if (p.type === "blackAsh") {
  ctx.globalCompositeOperation = "source-over";
  ctx.fillStyle = `rgba(8,7,6,${p.alpha})`;

  ctx.fillRect(
    drawX,
    drawY,
    p.size * 1.4,
    p.size
  );
}

  }

  ctx.restore();
}

