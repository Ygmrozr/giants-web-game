function drawParallaxLayer(layer) {
  if (
    !layer ||
    !layer.img.complete ||
    layer.img.naturalWidth === 0
  ) {
    return;
  }

  ctx.drawImage(
    layer.img,
    layer.x - camera.x * layer.speed,
    layer.y
  );
}

function drawParallax() {
  const settings =
    parallaxSettings[currentBattle] ||
    parallaxSettings[1];

  // Layer 1: en uzak gökyüzü/arka plan
  drawParallaxLayer(settings[0]);

  // Muazzam Dev Layer 1 ve Layer 2 arasında
  if (isBattle5Sector()) {
    drawColossalBackgroundTitan();
  }

  // Layer 2 ve sonraki katmanlar
  for (let i = 1; i < settings.length; i++) {
    drawParallaxLayer(settings[i]);
  }
}

