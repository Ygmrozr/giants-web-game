<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8" />
  <title>Giants Game</title>
  <%- include("partials/music") %>
<%- include("partials/top-controls") %>
<style>
  *{
    box-sizing:border-box;
    margin:0;
    padding:0;
    font-family:Arial, Helvetica, sans-serif;
  }
  
body::before{
  content:"";
  position:fixed;
  inset:0;
  background:
    radial-gradient(circle at center,
    rgba(255,190,90,0.08) 0%,
    rgba(40,60,90,0.12) 35%,
    transparent 70%);
  pointer-events:none;
  z-index:-1;
}

  body{
    background:
    radial-gradient(circle at top, #1f2733 0%, #0d1218 45%, #05070a 100%);
    color:white;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
    flex-direction:column;
    gap:8px;
    overflow:hidden;
  }

  .objective-hud,
  .menu-bar,
  .topbar,
  .help{
    display:none;
  }

  .game-header{
    backdrop-filter:blur(6px);
    width:1200px;
    height:46px;
    display:grid;
    grid-template-columns:1fr auto 1fr;
    align-items:center;
    padding:0 14px;
    background:rgba(0,0,0,0.42);
    border:1px solid rgba(215,175,100,0.45);
    box-shadow:0 0 18px rgba(0,0,0,0.45);
  }

  .header-left{
    display:flex;
    align-items:center;
    gap:8px;
    font-size:15px;
  }

  .player-label{
    color:#d9b46a;
    font-weight:bold;
    letter-spacing:.5px;
  }

  .header-center{
    color:#f4d27a;
    font-size:15px;
    font-weight:bold;
    letter-spacing:.6px;
  }

  .header-right{
    display:flex;
    justify-content:flex-end;
    gap:18px;
  }

  .header-right a{
    color:white;
    text-decoration:none;
    font-size:14px;
    font-weight:bold;
  }

  .header-right a:hover{
    color:#f4d27a;
  }

  .control-hint{
    width:1200px;
    font-size:12px;
    color:rgba(255,255,255,0.72);
    padding-left:4px;
    margin-top:-2px;
  }

  canvas{
    background:linear-gradient(to top, #1a1a1a 0%, #101820 55%, #0a1018 100%);
    border:3px solid #2b241b;
    display:block;
    cursor:crosshair;
    box-shadow:
      0 0 0 4px rgba(0,0,0,0.75),
      0 0 35px rgba(0,0,0,0.9);
  }


.game-canvas-wrap{
  position:relative;
  width:1200px;
  height:650px;
}

.complete-sector-canvas-btn{
  display:none;
  position:absolute;
  bottom:18px;
  right:18px;
  z-index:20;

  padding:11px 15px;
  background:
  radial-gradient(circle at center, rgba(255,150,35,0.12), transparent 38%);
  color:white;
  border:1px solid rgba(244,210,122,0.55);
  font-weight:900;
  font-size:12px;
  letter-spacing:.8px;
  cursor:pointer;

  box-shadow:
    0 0 16px rgba(31,139,255,0.42),
    inset 0 0 12px rgba(255,255,255,0.08);
}

.complete-sector-canvas-btn:hover{
  filter:brightness(1.18);
  transform:translateY(-1px);
}

#completeSectorBtn:hover{
  filter:brightness(1.18);
  transform:translateY(-1px);
}

.game-over-actions{
  display:none;
  position:absolute;
  left:50%;
  top:535px;
  transform:translateX(-50%);
  z-index:35;
  gap:16px;
  justify-content:center;
  align-items:center;
  padding:10px 14px;
  background:rgba(3,4,5,0.38);
  border:1px solid rgba(218,178,91,0.22);
  box-shadow:0 18px 40px rgba(0,0,0,0.42);
  backdrop-filter:blur(3px);
}

.game-over-actions button{
  min-width:154px;
  height:44px;
  padding:0 18px;
  border:1px solid rgba(236,190,88,0.78);
  color:white;
  font-size:13px;
  font-weight:900;
  letter-spacing:1.15px;
  cursor:pointer;
  text-transform:uppercase;
  box-shadow:
    0 0 0 2px rgba(0,0,0,0.62),
    0 14px 26px rgba(0,0,0,0.45),
    inset 0 1px 0 rgba(255,255,255,0.14),
    inset 0 -14px 24px rgba(0,0,0,0.28);
  transition:.18s ease;
}

.game-over-actions button:hover{
  transform:translateY(-2px);
  filter:brightness(1.18);
}

.game-over-actions button:active{
  transform:translateY(0);
}

.game-over-retry{
  background:linear-gradient(180deg, #8f231c, #4a0907);
}

.game-over-menu{
  background:linear-gradient(180deg, #4a463c, #151515);
}

.game-over-map{
  background:linear-gradient(180deg, #105f95, #061f39);
}

.sector-result-panel{
  display:none;
  position:fixed;
  inset:0;
  background:
  radial-gradient(circle at center, rgba(255,150,35,0.12), transparent 38%);
  z-index:99999;
  justify-content:center;
  align-items:center;
  backdrop-filter:blur(6px);
}

.sector-result-card{
  width:760px;
  padding:18px 22px 20px;
  background:
    linear-gradient(180deg, rgba(28,20,10,0.98), rgba(4,5,6,0.98)),
    repeating-linear-gradient(45deg, rgba(255,255,255,0.025) 0 1px, transparent 1px 7px);
  border:2px solid rgba(255,198,73,0.85);
  box-shadow:
    0 0 0 3px rgba(0,0,0,0.65),
    0 0 45px rgba(0,0,0,0.95),
    0 0 32px rgba(255,142,30,0.24);
  color:white;
  text-align:center;
  position:relative;
}

.result-title{
  color:#f6d070;
  font-size:18px;
  letter-spacing:7px;
  font-weight:900;
  margin-bottom:8px;
  text-shadow:0 0 14px rgba(255,190,70,0.5);
}

.rank-area{
  display:flex;
  justify-content:center;
  align-items:center;
  gap:28px;
  margin-bottom:2px;
}

.rank-laurel{
  font-size:44px;
  color:rgba(255,205,88,0.75);
  text-shadow:0 0 16px rgba(255,190,60,0.45);
}

.result-rank{
  font-size:72px;
  line-height:1;
  font-weight:900;
  color:#ff4d4d;
  text-shadow:0 0 25px currentColor;
}

.result-stars{
  display:flex;
  justify-content:center;
  gap:12px;
  font-size:20px;
  margin:2px 0 12px;
}

.result-stars span{
  color:#333;
  text-shadow:none;
}

.result-stars span.active{
  color:#ffd700;
  text-shadow:0 0 12px rgba(255,215,0,0.8);
}

.result-stats{
  display:grid;
  grid-template-columns:repeat(5, 1fr);
  gap:8px;
  margin-bottom:12px;
}

.stat-card{
  min-height:115px;
  padding:9px 6px;
  background:linear-gradient(180deg, rgba(255,255,255,0.055), rgba(0,0,0,0.35));
  border:1px solid rgba(255,210,100,0.35);
  box-shadow:inset 0 0 24px rgba(0,0,0,0.55);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
}

.stat-icon{
  font-size:28px;
  margin-bottom:6px;
  text-shadow:0 0 14px currentColor;
}

.stat-card span{
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:1.5px;
  opacity:.9;
}

.stat-card strong{
  font-size:10px;
  margin-top:10px;
  line-height:1;
}

.stat-card small{
  margin-top:10px;
  font-size:13px;
  color:rgba(255,255,255,0.76);
  font-weight:bold;
}

.score-card{ color:#ffd86b; border-color:rgba(255,216,107,0.55); }
.kill-card{ color:#ff4d3d; border-color:rgba(255,77,61,0.55); }
.medal-card{ color:#49bfff; border-color:rgba(73,191,255,0.55); }
.combo-card{ color:#ffc247; border-color:rgba(255,194,71,0.55); }
.reward-card{ color:#b15cff; border-color:rgba(177,92,255,0.55); }

.result-summary{
  display:grid;
  grid-template-columns:1fr 1fr 1.4fr;
  gap:0;
  border:1px solid rgba(255,210,100,0.35);
  margin-bottom:22px;
  background:rgba(0,0,0,0.32);
}

.result-summary > div{
  padding:9px 12px;
  border-right:1px solid rgba(255,210,100,0.18);
}

.result-summary > div:last-child{
  border-right:none;
}

.result-summary span{
  display:block;
  color:#d6b66a;
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:1.5px;
  margin-bottom:6px;
}

.result-summary strong{
  font-size:24px;
  color:#ffd86b;
  text-shadow:0 0 12px rgba(255,216,107,0.35);
}

.rank-progress{
  height:20px;
  background:rgba(0,0,0,0.55);
  border:1px solid rgba(255,210,100,0.35);
  margin-top:8px;
  overflow:hidden;
}

#nextRankProgress{
  height:100%;
  width:0%;
  background:linear-gradient(90deg, #ff5a1f, #ffd86b);
  box-shadow:0 0 14px rgba(255,160,35,0.7);
}

#nextRankText{
  display:block;
  margin-top:6px;
  color:#e8d098;
  font-size:14px;
  font-weight:bold;
}

.result-actions{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:14px;
  padding:0 45px;
}

.result-actions button{
  padding:9px 12px;
  border:none;
  cursor:pointer;
  color:white;
  font-size:13px;
  font-weight:900;
  letter-spacing:.5px;
  border:1px solid rgba(255,255,255,0.22);
  transition:.18s;
}

.result-actions button:hover{
  transform:translateY(-2px);
  filter:brightness(1.18);
}

.btn-retry{
  background:linear-gradient(135deg, #8b1818, #3d0909);
  box-shadow:0 0 16px rgba(255,55,35,0.25);
}

.btn-menu{
  background:linear-gradient(135deg, #373737, #131313);
}

.btn-next{
  background:linear-gradient(135deg, #0f8cff, #073b8e);
  box-shadow:0 0 16px rgba(31,139,255,0.35);
}

#goMenuBtn{
  background:linear-gradient(135deg, #3a3a3a, #1c1c1c);
}



</style>

</head>
<body>
  <div 
  id="gameMeta"
  data-objective-type="<%= sectorData.objectiveType %>"
  data-target-kill-count="<%= sectorData.enemyCount || 0 %>"
  data-target-item-count="<%= sectorData.itemTarget || 0 %>"
  data-spawn-enemy-count="<%= 
  sectorData.objectiveType === 'kill' && Number(sector) !== 10 
    ? (sectorData.enemyCount || 0) + 3 
    : (sectorData.enemyCount || 0) 
%>"
  data-spawn-gas-count="<%= sectorData.objectiveType === 'collect' ? (sectorData.itemTarget || 0) + 2 : 2 %>"
  data-level="<%= level %>"
  data-sector="<%= sector %>"
></div>

  <div class="objective-hud">
  <div>Level <%= level %> - Sector <%= sector %></div>
  <div><%= sectorData.objectiveText %></div>

  <div id="objectiveProgress">
  <% if (sectorData.objectiveType === "reach") { %>
    NOT REACHED
  <% } else { %>
    0 / <%= sectorData.itemTarget || sectorData.enemyCount %>
  <% } %>
</div>

</div>

