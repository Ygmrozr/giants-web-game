      const playerCenterX = player.x + player.width / 2;
      const titanCenterX = titan.x + titan.width / 2;

      if (titan.alive && titan.state === "walk") {
        titan.stepDustTimer++;

        if (titan.stepDustTimer >= (titan.isBoss ? 18 : 32)) {
          titan.stepDustTimer = 0;

          stompDusts.push({
  x: titan.x + titan.width / 2,
  y: ground.y - 18,
  life: titan.isBoss ? 24 : 18,
  size: titan.isBoss ? rand(18, 30) : rand(12, 22),
  vx: rand(-0.35, 0.35),
vy: rand(-0.25, -0.05)
});

          if (titan.isBoss) {
            screenShakeTimer = Math.max(screenShakeTimer, 5);
          }
        }
      }

      if (titan.rageTimer > 0) {
        titan.dir = playerCenterX < titanCenterX ? -1 : 1;
        titan.faceDir = titan.dir;

        titan.x += titan.dir * titan.moveSpeed * 1.25;

        const closeEnoughForRageDamage = Math.abs(playerCenterX - titanCenterX) < 105;

        if (
          currentBattle >= 5 &&
          closeEnoughForRageDamage &&
          titan.rageDamageCooldown <= 0 &&
          !player.grabbed
        ) {
          damagePlayer(8, titan.x + titan.width / 2);
          titan.rageDamageCooldown = 75;
        }

        const closeEnoughToGrab = Math.abs(playerCenterX - titanCenterX) < 95;

        if (
          titan.isBoss &&
          closeEnoughToGrab &&
          titan.attackCooldown <= 0 &&
          !player.grabbed &&
          Math.random() < 0.35
        ) {
          player.grabbed = true;
          player.grabbedBy = titan;
          player.escapeProgress = 0;
          player.escapeTimer = 120;

          titan.attackCooldown = 80;
          titan.attackFlashTimer = 20;
        }
      } else {
        titan.x += titan.dir * titan.moveSpeed;

        if (titan.x <= titan.minX) titan.dir = 1;
        if (titan.x >= titan.maxX) titan.dir = -1;
      }
    }

    titan.faceDir = titan.dir;

    if (player.attackTimer > 0) {
      attackTitanIfPossible(titan);
    }

    const titanRect = {
      x: titan.x,
      y: titan.y,
      width: titan.width,
      height: titan.height
    };

    if (rectsCollide(getPlayerRect(), titanRect)) {
      if (titan.stunTimer <= 0 && titanCanAttackPlayer(titan) && titan.attackCooldown <= 0) {
        damagePlayer(titan.damage, titan.x + titan.width / 2);
        titan.attackCooldown = titan.rageTimer > 0 ? 120 : 40;
        titan.attackFlashTimer = 12;
      }
    }
  });
}


    function updateItems() {
      if (game.state !== "playing") return;

      items.forEach(item => {
        if (item.collected) return;

        const itemRect = {
          x: item.x,
          y: item.y,
          width: item.width,
          height: item.height
        };

        if (rectsCollide(getPlayerRect(), itemRect)) {
          item.collected = true;
          itemScore += item.score;
          itemCollectedCount++;

          if (item.kind === "gas") {
            collectedSupplyCount++;
          }

          if (item.kind === "score") {
  collectedMedalCount += item.medals || 1;
}

          updateObjectiveProgress();


          if (item.kind === "boost") {
            player.boostMode = true;
            player.boostTimer = 520;
            player.vx += 1.5 * player.facing;
            player.vy -= 1.5;
          } else if (item.kind === "medkit") {
            player.health = Math.min(player.maxHealth, player.health + item.heal);
          } else if (item.kind === "gas") {
            player.gas = Math.min(player.maxGas, player.gas + item.gas);
          }
        }
      });
    }

