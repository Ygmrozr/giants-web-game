      alpha: rand(0.06, 0.13)
    });
  }

  // Turuncu köz / ateş parçacıkları
  for (let i = 0; i < 90; i++) {
    atmosphereParticles.push({
      type: "ember",
      x: rand(0, WORLD.width),
      y: rand(40, canvas.height - 40),
      size: rand(1.2, 2.8),
      length: rand(5, 14),
      speedX: rand(-0.45, -0.12),
      speedY: rand(-0.18, 0.08),
      alpha: rand(0.28, 0.65),
      flicker: rand(0, Math.PI * 2)
    });
  }

  // Performans dostu siyah kül
for (let i = 24; i < 90 + 28; i++) {
  atmosphereParticles.push({
    type: "blackAsh",
    x: rand(0, WORLD.width),
    y: rand(40, canvas.height - 50),
    size: rand(2.2, 4.5),
    speedX: rand(-0.26, -0.06),
    speedY: rand(0.03, 0.13),
    alpha: rand(0.20, 0.38)
  });
}

}

function updateAtmosphereParticles() {
  for (const p of atmosphereParticles) {
    p.x += p.speedX;
    p.y += p.speedY;

    if (p.type === "ember") {
      p.flicker += 0.18;
      p.y += Math.sin(p.flicker) * 0.15;
    }

    if (p.x < 0) p.x = WORLD.width;
    if (p.x > WORLD.width) p.x = 0;

    if (p.y < 20) p.y = canvas.height - 40;
    if (p.y > canvas.height - 20) p.y = 40;
  }
}

function drawAtmosphereParticles() {
  ctx.save();

  for (const p of atmosphereParticles) {
    const drawX = p.x - camera.x;
    const drawY = p.y;

    if (drawX < -60 || drawX > canvas.width + 60) continue;

    if (p.type === "dust") {
      ctx.globalCompositeOperation = "screen";

      const gradient = ctx.createRadialGradient(
        drawX,
        drawY,
        0,
        drawX,
        drawY,
        p.size
      );

      gradient.addColorStop(0, `rgba(210,150,75,${p.alpha})`);
      gradient.addColorStop(0.45, `rgba(130,90,55,${p.alpha * 0.45})`);
      gradient.addColorStop(1, "rgba(80,50,30,0)");

      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);
      ctx.fill();
    }

    if (p.type === "ember") {
  const flickerAlpha = p.alpha * (0.75 + Math.sin(p.flicker) * 0.15);

  ctx.globalCompositeOperation = "screen";
  ctx.fillStyle = `rgba(255,95,25,${flickerAlpha})`;

  ctx.beginPath();
  ctx.arc(drawX, drawY, p.size, 0, Math.PI * 2);
  ctx.fill();
}


if (p.type === "blackAsh") {
  ctx.globalCompositeOperation = "source-over";
  ctx.fillStyle = `rgba(8,7,6,${p.alpha})`;

  ctx.fillRect(
    drawX,
    drawY,
    p.size * 1.4,
    p.size
  );
}

  }

  ctx.restore();
}

function drawFogLayer() {
  ctx.save();

  ctx.globalCompositeOperation = "screen";

  // Uzak ince sis
  for (let i = 0; i < 7; i++) {
    const x = ((i * 320) - camera.x * 0.10) % 1600;
    const y = 170 + Math.sin(i * 1.7 + camera.x * 0.001) * 12;

    const fog = ctx.createRadialGradient(x, y, 20, x, y, 260);
    fog.addColorStop(0, "rgba(120,135,145,0.055)");
    fog.addColorStop(0.5, "rgba(95,105,115,0.035)");
    fog.addColorStop(1, "rgba(80,90,100,0)");

    ctx.fillStyle = fog;
    ctx.beginPath();
    ctx.ellipse(x, y, 310, 70, 0, 0, Math.PI * 2);
    ctx.fill();
  }

  // Orta katman dalgalı sis
  for (let i = 0; i < 6; i++) {
    const x = ((i * 360) - camera.x * 0.22) % 1800;
    const y = 300 + Math.sin(i * 2.1 + camera.x * 0.0018) * 18;

    const fog = ctx.createRadialGradient(x, y, 30, x, y, 300);
    fog.addColorStop(0, "rgba(170,145,105,0.07)");
    fog.addColorStop(0.45, "rgba(130,105,80,0.04)");
    fog.addColorStop(1, "rgba(80,60,45,0)");

    ctx.fillStyle = fog;
    ctx.beginPath();
    ctx.ellipse(x, y, 360, 85, 0, 0, Math.PI * 2);
    ctx.fill();
  }

  // Zemine yakın savaş sisi
  for (let i = 0; i < 8; i++) {
    const x = ((i * 260) - camera.x * 0.35) % 1500;
    const y = 535 + Math.sin(i * 1.3 + camera.x * 0.0025) * 10;

    const fog = ctx.createRadialGradient(x, y, 20, x, y, 220);
    fog.addColorStop(0, "rgba(185,160,120,0.075)");
    fog.addColorStop(0.55, "rgba(120,100,80,0.04)");
    fog.addColorStop(1, "rgba(80,60,45,0)");

    ctx.fillStyle = fog;
    ctx.beginPath();
    ctx.ellipse(x, y, 300, 45, 0, 0, Math.PI * 2);
    ctx.fill();
  }

  ctx.globalCompositeOperation = "source-over";
  ctx.restore();
}

function spawnOdmGasTrail() {
  if (!player.grappling && !player.boostMode) return;

  const speed = Math.abs(player.vx) + Math.abs(player.vy);
  if (speed < 4) return;

  if (Math.random() > 0.55) return;

  odmGasTrails.push({
    x: player.x + player.width / 2 - player.facing * 34,
    y: player.y + player.height * 0.62,
    vx: -player.vx * 0.18 + rand(-0.4, 0.4),
    vy: -player.vy * 0.10 + rand(-0.25, 0.25),
    size: rand(8, 16),
    life: randInt(18, 28),
    maxLife: 28
  });
}

function updateOdmGasTrails() {
  for (let i = odmGasTrails.length - 1; i >= 0; i--) {
    const p = odmGasTrails[i];

    p.x += p.vx;
    p.y += p.vy;
    p.vx *= 0.94;
    p.vy *= 0.94;
    p.size *= 1.035;
    p.life--;

    if (p.life <= 0) {
      odmGasTrails.splice(i, 1);
    }
  }
}

function drawOdmGasTrails() {
  ctx.save();

  for (const p of odmGasTrails) {
    const alpha = p.life / p.maxLife;

    ctx.fillStyle = `rgba(190,190,180,${0.14 * alpha})`;
    ctx.beginPath();
    ctx.ellipse(
      p.x - camera.x,
      p.y,
      p.size * 2.1,
p.size * 0.45,
      0,
      0,
      Math.PI * 2
    );
    ctx.fill();
  }

  ctx.restore();
}

