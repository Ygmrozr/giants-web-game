    function updateObjectiveProgress() {
  const progressEl = document.getElementById("objectiveProgress");
  const completeBtn = document.getElementById("completeSectorBtn");

  if (!progressEl) return;

  if (objectiveType === "kill") {
    progressEl.textContent = `${titanKillCount} / ${targetKillCount}`;

    if (titanKillCount >= targetKillCount && !objectiveCompleted) {
      if (
        isFemaleTitanFinalSector &&
        femaleFinalPhase !== "crystal"
      ) {
        return;
      }

      objectiveCompleted = true;
      objectiveCompleteNoticeTimer = 180;

      if (completeBtn) {
        completeBtn.style.display = "block";
      }
    }
  }

  if (objectiveType === "collect") {
    progressEl.textContent = `${collectedMedalCount} / ${targetItemCount}`;

    if (collectedMedalCount >= targetItemCount && !objectiveCompleted) {
      objectiveCompleted = true;
      objectiveCompleteNoticeTimer = 180;

      if (completeBtn) {
        completeBtn.style.display = "block";
      }
    }
  }

  if (objectiveType === "reach") {
    progressEl.textContent = objectiveCompleted ? "COMPLETED" : "NOT REACHED";
  }
}

