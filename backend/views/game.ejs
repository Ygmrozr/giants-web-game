    const nightSpriteCache = new Map();

function getBattleSpriteImage(img, spriteType) {
  if (currentBattle !== 4) {
    return img;
  }

  if (!img || !img.complete || img.naturalWidth <= 0) {
    return img;
  }

  const cacheKey = `${spriteType}:${img.src}`;

  if (nightSpriteCache.has(cacheKey)) {
    return nightSpriteCache.get(cacheKey);
  }

  const offscreenCanvas = document.createElement("canvas");
  offscreenCanvas.width = img.naturalWidth;
  offscreenCanvas.height = img.naturalHeight;

  const offscreenCtx = offscreenCanvas.getContext("2d");

  if (spriteType === "player") {
  offscreenCtx.filter =
    "brightness(0.95) contrast(1.10) saturate(0.60)";
} else {
  offscreenCtx.filter =
    "brightness(0.85) contrast(1.08) saturate(0.68)";
}

offscreenCtx.drawImage(
  img,
  0,
  0,
  offscreenCanvas.width,
  offscreenCanvas.height
);

offscreenCtx.filter = "none";

offscreenCtx.globalCompositeOperation = "source-atop";

offscreenCtx.fillStyle =
  spriteType === "player"
    ? "rgba(90, 135, 205, 0.06)"
    : "rgba(75, 115, 190, 0.08)";

offscreenCtx.fillRect(
  0,
  0,
  offscreenCanvas.width,
  offscreenCanvas.height
);

offscreenCtx.globalCompositeOperation = "source-over";

  nightSpriteCache.set(cacheKey, offscreenCanvas);

  return offscreenCanvas;
}



