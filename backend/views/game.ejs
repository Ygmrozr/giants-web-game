    function getPlayerImage() {
  if (player.health <= 0) {
    return playerSprites.dead;
  }

  if (player.attackTimer > 0) {
    return playerSprites.attack;
  }

  if (!player.onGround) {
    return playerSprites.jump;
  }

  if (game.state === "playing" && Math.abs(player.vx) > 0.5) {
    const runFrames = [
      playerSprites.run1,
      playerSprites.run2,
      playerSprites.run3,
      playerSprites.run4
    ];

    const runIndex = Math.floor(Date.now() / 110) % runFrames.length;
    return runFrames[runIndex];
  }

  return playerSprites.idle;
}

function drawPlayerSprite(
  img,
  drawX,
  drawY,
  drawWidth,
  drawHeight,
  facing
) {
  ctx.save();

  const renderImage = getBattleSpriteImage(img, "player");

  if (facing === -1) {
    ctx.scale(-1, 1);

    ctx.drawImage(
      renderImage,
      -drawX - drawWidth,
      drawY,
      drawWidth,
      drawHeight
    );
  } else {
    ctx.drawImage(
      renderImage,
      drawX,
      drawY,
      drawWidth,
      drawHeight
    );
  }

  ctx.restore();
}

function drawPlayer() {
  const img = getPlayerImage();
  const PLAYER_SCALE = 0.84;

  const hitboxX = player.x - camera.x;
  const hitboxY = player.y;

  if (img && img.complete && img.naturalWidth > 0) {
    const drawHeight = player.height * PLAYER_SCALE;
    const drawWidth = drawHeight * (img.naturalWidth / img.naturalHeight);

    const drawX = hitboxX + player.width / 2 - drawWidth / 2;
    const drawY = hitboxY + player.height - drawHeight;

    drawPlayerSprite(
      img,
      drawX,
      drawY,
      drawWidth,
      drawHeight,
      player.facing
    );
  } else {
    ctx.fillStyle = "#2ecc71";
    ctx.fillRect(hitboxX, hitboxY, player.width, player.height);
  }
}

function drawCivilian(civilian) {
  if (!civilian) return;

  let sprite = civilianSprites.idle;

  const isCarried =
    civilian.following && !player.onGround;

  const shouldRun =
    civilian.following && player.onGround && Math.abs(player.vx) > 0.4;

  const isScared =
    femaleAttackMode === "warning" || civilianDangerTimer > 0;
    if (isScared && !civilian.screamPlayed) {
  playSfx("civilianScream", 0.55, 1500);
  civilian.screamPlayed = true;
}
    

  if (civilian.dead) {
    sprite = civilianSprites.dead;
  } else if (civilian.rescued) {
    sprite = civilianSprites.rescued;
  } else if (isCarried) {
    sprite = civilianSprites.carried;
  } else if (isScared && shouldRun) {
    sprite = civilianRunFrames[civilian.frame % civilianRunFrames.length];
  } else if (isScared) {
    sprite = civilianSprites.scared;
  } else if (shouldRun) {
    sprite = civilianRunFrames[civilian.frame % civilianRunFrames.length];
  }

  const targetH = civilian.dead ? 95 : isCarried ? 90 : 110;
  const ratio = sprite.width / sprite.height;

  const drawH = targetH;
  const drawW = drawH * ratio;

  const drawX = civilian.x - camera.x - drawW / 2;

  const drawY = civilian.dead
    ? civilian.y + civilian.height - drawH + 8
    : civilian.y + civilian.height - drawH;

  ctx.save();

  if (civilian.facing === -1) {
    ctx.translate(drawX + drawW, drawY);
    ctx.scale(-1, 1);
    ctx.drawImage(sprite, 0, 0, drawW, drawH);
  } else {
    ctx.drawImage(sprite, drawX, drawY, drawW, drawH);
  }

  ctx.restore();
}


