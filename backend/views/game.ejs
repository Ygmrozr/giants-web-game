  <div class="game-header">
  <div class="header-left">
    <span class="player-label">Player</span>
    <strong><%= user.username %></strong>
  </div>

  <div class="header-center">
    Battle <%= level %> · Sector <%= sector %>
  </div>

  <div class="header-right">
    <a href="/profile">Profile</a>
    <a href="/menu">Main Menu</a>
    <a href="/map">Map</a>
    <a href="/market">Market</a>
  </div>
</div>

<div class="control-hint">
  A/D Move · W Jump · Space Attack · Mouse Grapple · E Carry Civilian · G Drop · R Restart
</div>

<div id="scoreText" style="display:none;">Keşif Madalyonu: 0</div>

<div class="game-canvas-wrap">
  <canvas id="gameCanvas" width="1200" height="650"></canvas>

  <button id="completeSectorBtn" class="complete-sector-canvas-btn">
    COMPLETE SECTOR
  </button>
</div>

    <div id="sectorResultPanel" class="sector-result-panel">
  <div class="sector-result-card">

    <div class="result-title">MISSION RESULT</div>

    <div class="rank-area">
      <div class="rank-laurel">❬</div>
      <div class="result-rank" id="resultRank">-</div>
      <div class="rank-laurel">❭</div>
    </div>

    <div class="result-stars" id="resultStars">
      <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
    </div>

    <div class="result-stats">
      <div class="stat-card score-card">
        <div class="stat-icon">⌖</div>
        <span>Score</span>
        <strong id="resultScore">0</strong>
        <small id="bestScoreText">BEST: 0</small>
      </div>

      <div class="stat-card kill-card">
        <div class="stat-icon">☠</div>
        <span>Titan Kills</span>
        <strong id="resultKills">0</strong>
        <small id="bestKillsText">BEST: 0</small>
      </div>

      <div class="stat-card medal-card">
        <div class="stat-icon">✪</div>
        <span>Medals</span>
        <strong id="resultMedals">0</strong>
        <small id="bestMedalsText">BEST: 0</small>
      </div>

      <div class="stat-card combo-card">
        <div class="stat-icon">⚔</div>
        <span>Best Combo</span>
        <strong id="resultCombo">0</strong>
        <small id="bestComboText">MAX: 0</small>
      </div>

      <div class="stat-card reward-card">
        <div class="stat-icon">▣</div>
        <span>Reward</span>
        <strong id="resultReward">After Save</strong>
        <small>Sector Clear Bonus</small>
      </div>
    </div>

    <div class="result-summary">
      <div>
        <span>Total Score</span>
        <strong id="resultTotalScore">0</strong>
      </div>

      <div>
        <span>Rank Points</span>
        <strong id="resultRankPoints">0</strong>
      </div>

      <div>
        <span>Next Rank</span>
        <div class="rank-progress">
          <div id="nextRankProgress"></div>
        </div>
        <small id="nextRankText">0 / 250</small>
      </div>
    </div>

    <div class="result-actions">
      <button id="retrySectorBtn" class="btn-retry">↻ Retry</button>
      <button id="goMenuBtn" class="btn-menu">⌂ Main Menu</button>
      <button id="nextSectorBtn" class="btn-next">Next Sector ❯</button>
    </div>

  </div>
</div>

