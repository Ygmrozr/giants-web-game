    function getTitanImage(titan) {
  if (titan.isFemaleTitan) {
    if (!titan.alive || titan.state === "dead") return femaleTitanSprites.dead;
    if (titan.hitCooldown > 0 || titan.stunTimer > 0 || titan.state === "hurt") return femaleTitanSprites.hurt;
    if (titan.attackFlashTimer > 0 || titan.attackCooldown > 28 || titan.state === "attack") return femaleTitanSprites.attack;
    if (titan.state === "walk") return femaleTitanWalkFrames[titan.frame % femaleTitanWalkFrames.length];
    return femaleTitanSprites.idle;
  }

  if (titan.isArmoredTitan) {
    if (!titan.alive || titan.state === "dead") return armoredTitanSprites.dead;
    if (titan.hitCooldown > 0 || titan.stunTimer > 0 || titan.state === "hurt") return armoredTitanSprites.hurt;
    if (titan.attackFlashTimer > 0 || titan.attackCooldown > 28 || titan.state === "attack") return armoredTitanSprites.attack;
    if (titan.state === "walk") return armoredTitanWalkFrames[titan.frame % armoredTitanWalkFrames.length];
    return armoredTitanSprites.idle;
  }

  if (titan.isBeastTitan) {
    if (!titan.alive || titan.state === "dead") return beastTitanSprites.dead;
    if (titan.hitCooldown > 0 || titan.stunTimer > 0 || titan.state === "hurt") return beastTitanSprites.hurt;
    if (titan.attackFlashTimer > 0 || titan.attackCooldown > 28 || titan.state === "attack") return beastTitanSprites.attack;
    if (titan.state === "walk") return beastTitanWalkFrames[titan.frame % beastTitanWalkFrames.length];
    return beastTitanSprites.idle;
  }

  if (!titan.alive || titan.state === "dead") return titanSprites.dead;
  if (titan.hitCooldown > 0 || titan.stunTimer > 0 || titan.state === "hurt") return titanSprites.hurt;
  if (titan.attackFlashTimer > 0 || titan.attackCooldown > 28 || titan.state === "attack") return titanSprites.attack;
  if (titan.state === "walk") return titanWalkFrames[titan.frame % titanWalkFrames.length];
  if (titan.state === "idle2") return titanSprites.idle2;

  return titanSprites.idle1;
}

function getTitanDrawRect(titan) {
  const img = getTitanImage(titan);

  const hitboxX = titan.x;
  const hitboxY = titan.y;

  let drawHeight = titan.height;
  let drawWidth = titan.width;

  if (img && img.complete && img.naturalWidth > 0) {
    if (!titan.alive || titan.state === "dead") {
      drawWidth = titan.height * 1.30;
      drawHeight = drawWidth * (img.naturalHeight / img.naturalWidth);
    } else {
      const TITAN_DRAW_SCALE = 1.22;
drawHeight = titan.height * TITAN_DRAW_SCALE;
      drawWidth = drawHeight * (img.naturalWidth / img.naturalHeight);
    }
  }

  const drawX = hitboxX + titan.width / 2 - drawWidth / 2;
  const drawY = hitboxY + titan.height - drawHeight;

  return {
    x: drawX,
    y: drawY,
    width: drawWidth,
    height: drawHeight,
    img
  };
}

    function drawTitans() {
  titans.forEach(titan => {
    if (
      titan.isFemaleTitan &&
      isFemaleTitanFinalSector &&
      (femaleFinalPhase === "annieLying" || femaleFinalPhase === "crystal")
    ) {
      return;
    }

    const shouldDrawDead = !titan.alive && titan.deadTimer > 0;

    if (!titan.alive && !shouldDrawDead && !titan.drawDead) return;

    const rect = getTitanDrawRect(titan);
    const img = rect.img;

    const hitboxX = titan.x - camera.x;
    const hitboxY = titan.y;

    const drawX = rect.x - camera.x;
    const drawY = rect.y;
    const drawWidth = rect.width;
    const drawHeight = rect.height;

    if (img && img.complete && img.naturalWidth > 0) {
  ctx.save();

  const renderImage = getBattleSpriteImage(img, "titan");

  if (titan.faceDir === -1) {
    ctx.scale(-1, 1);

    ctx.drawImage(
      renderImage,
      -drawX - drawWidth,
      drawY,
      drawWidth,
      drawHeight
    );
  } else {
    ctx.drawImage(
      renderImage,
      drawX,
      drawY,
      drawWidth,
      drawHeight
    );
  }

  ctx.restore();
}else {
      ctx.fillStyle = titan.hitCooldown > 0 ? "#e9897f" : "#c96a5d";
      ctx.fillRect(hitboxX, hitboxY, titan.width, titan.height);
    }

    if (titan.alive && titan.bloodTimer > 0) {
      ctx.fillStyle = "rgba(180,0,0,0.75)";
      ctx.beginPath();
      ctx.arc(
        drawX + drawWidth / 2,
        drawY + drawHeight * 0.23,
        7,
        0,
        Math.PI * 2
      );
      ctx.fill();
    }

    if (titan.alive && titan.stunTimer > 0) {
      ctx.fillStyle = "#ffd54f";

      ctx.beginPath();
      ctx.arc(drawX + drawWidth / 2, drawY - 18, 4, 0, Math.PI * 2);
      ctx.fill();

      ctx.beginPath();
      ctx.arc(drawX + drawWidth / 2 - 10, drawY - 11, 4, 0, Math.PI * 2);
      ctx.fill();

      ctx.beginPath();
      ctx.arc(drawX + drawWidth / 2 + 10, drawY - 11, 4, 0, Math.PI * 2);
      ctx.fill();
    }

    if (titan.alive) {
      const barWidth = titan.isBoss ? 90 : 70;
      const barHeight = 7;
      const healthRatio = Math.max(0, titan.health / titan.maxHealth);
      const needsNapeFinisher = titan.health <= 1;

      const spriteCenterX = drawX + drawWidth / 2;
      const barX = spriteCenterX - barWidth / 2;
      const barY = drawY - 5;

      if (needsNapeFinisher) {
        ctx.fillStyle = "rgba(0,0,0,0.65)";
        ctx.fillRect(barX - 10, barY - 4, barWidth + 20, 18);

        ctx.fillStyle = "#ff4444";
        ctx.font = "bold 11px Arial";
        ctx.textAlign = "center";
        ctx.fillText("FINAL STRIKE!", barX + barWidth / 2, barY + 9);
        ctx.textAlign = "left";
      } else {
        ctx.fillStyle = "rgba(0,0,0,0.55)";
        ctx.fillRect(barX, barY, barWidth, barHeight);

        ctx.fillStyle =
          healthRatio > 0.5
            ? "#2ecc71"
            : healthRatio > 0.25
            ? "#f1c40f"
            : "#e74c3c";

        ctx.fillRect(barX, barY, barWidth * healthRatio, barHeight);

        ctx.strokeStyle = "rgba(255,255,255,0.75)";
        ctx.lineWidth = 1;
        ctx.strokeRect(barX, barY, barWidth, barHeight);
      }

      if (titan.isBoss) {
        ctx.fillStyle = "#f1c40f";
        ctx.font = "bold 12px Arial";
        ctx.textAlign = "center";
        ctx.fillText("BOSS", barX + barWidth / 2, barY - 6);
        ctx.textAlign = "left";
      }
    }
  });
}



