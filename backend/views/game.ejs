function updateTimers() {
  if (player.boostMode) {
    player.boostTimer--;
    if (player.boostTimer <= 0) {
      player.boostMode = false;
    }
  }

  if (player.attackTimer > 0) player.attackTimer--;
  if (player.attackCooldown > 0) player.attackCooldown--;
  if (player.hitFlashTimer > 0) player.hitFlashTimer--;
  if (game.invincibleTimer > 0) game.invincibleTimer--;

  if (femalePushCooldown > 0) femalePushCooldown--;

if (femaleAttackCooldown > 0) femaleAttackCooldown--;
if (femaleAttackWarningTimer > 0) femaleAttackWarningTimer--;

if (civilianDangerTimer > 0) {
  civilianDangerTimer--;
}

  if (player.throwTimer > 0) {
    player.throwTimer--;

    if (player.throwTimer <= 0) {
      player.thrown = false;
    }
  }

  if (comboTimer > 0) {
  comboTimer--;
}

if (lastKillTime > 0 && performance.now() - lastKillTime > COMBO_WINDOW) {
  comboCount = 0;
  lastKillTime = 0;
}

  if (comboDisplayTimer > 0) {
    comboDisplayTimer--;
  }

  if (comboPopTimer > 0) {
  comboPopTimer--;
}

  for (let i = comboParticles.length - 1; i >= 0; i--) {
  const p = comboParticles[i];

  p.x += p.vx;
  p.y += p.vy;
  p.vx *= 0.92;
  p.vy *= 0.92;
  p.life--;

  if (p.life <= 0) {
    comboParticles.splice(i, 1);
  }
}

  for (let i = grappleSparks.length - 1; i >= 0; i--) {
    const p = grappleSparks[i];

    p.x += p.vx;
    p.y += p.vy;

    if (p.type === "spark") {
      p.vx *= 0.82;
      p.vy *= 0.82;
    } else {
      p.vx *= 0.95;
      p.vy *= 0.95;
      p.size *= 1.04;
    }

    p.life--;

    if (p.life <= 0) {
      grappleSparks.splice(i, 1);
    }
  }

  titans.forEach(t => {
    if (t.hitCooldown > 0) t.hitCooldown--;
    if (t.attackCooldown > 0) t.attackCooldown--;
    if (t.attackFlashTimer > 0) t.attackFlashTimer--;
    if (t.bloodTimer > 0) t.bloodTimer--;
    if (t.stunTimer > 0) t.stunTimer--;
    if (t.rageTimer > 0) t.rageTimer--;
    if (t.rageDamageCooldown > 0) t.rageDamageCooldown--;
    if (t.staggerCooldown > 0) t.staggerCooldown--;
    if (t.staggerImmunityTimer > 0) t.staggerImmunityTimer--;
  });

  if (finalStrikeTimer > 0) finalStrikeTimer--;
  if (screenShakeTimer > 0) screenShakeTimer--;

  updateBloodEffects();

  speedLines = speedLines.filter(line => {
    line.x += line.vx;
    line.y += line.vy;
    line.life--;
    return line.life > 0;
  });

  boostTrails = boostTrails.filter(trail => {
    trail.life--;
    return trail.life > 0;
  });

  stompDusts = stompDusts.filter(dust => {
    dust.x += dust.vx;
    dust.y += dust.vy;
    dust.life--;
    return dust.life > 0;
  });

  updateOdmGasTrails();
} 

