  ctx.strokeRect(22, 570, 210, 54);

  ctx.fillStyle = "#f4d27a";
  ctx.font = "bold 15px Arial";
  ctx.fillText("Keşif Madalyonu", 58, 592);

  ctx.fillStyle = "#ffffff";
  ctx.font = "bold 24px Arial";
  ctx.fillText(collectedMedalCount, 58, 618);

  // GAZ BİTTİ UYARISI
  if (player.gas <= 0) {
    ctx.fillStyle = "#ff5555";
