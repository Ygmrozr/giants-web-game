    function startGrapple(target) {
  if (player.grappling) return;

  const minGrappleY = grappleMinYByBattle[currentBattle] || 180;

  if (target.y < minGrappleY) {
    return;
  }

  if (player.gas <= 0) return;

  const gasCost = 3;

  if (player.gas < gasCost) return;

  player.gas -= gasCost;

  const px = player.x + player.width / 2;
  const py = player.y + player.height / 2;

  spawnGrappleSpark(
    target.x + rand(-18, 18),
    target.y + rand(-22, -10)
  );

  player.grappling = true;
  playSfx("grapple", 0.35);
  playSfx("grappleImpact", 0.45, 120);
  player.grappleTarget = {
    x: target.x,
    y: target.y
  };

  const dx = target.x - px;
  const dy = target.y - py;
  const len = Math.max(1, Math.sqrt(dx * dx + dy * dy));

  player.vx += (dx / len) * 2.6;
  player.vy += (dy / len) * 2.6;
  player.onGround = false;
}

function addKillCombo() {
  const now = performance.now();

  if (now - lastKillTime <= COMBO_WINDOW) {
    comboCount++;
  } else {
    comboCount = 1;
  }

  lastKillTime = now;

  comboTimer = 600;
comboDisplayTimer = 180;
  comboPopTimer = 12;

  bestCombo = Math.max(bestCombo, comboCount);
  savedBestCombo = Math.max(savedBestCombo, bestCombo);

  if (comboParticles.length > 30) {
    comboParticles.splice(0, comboParticles.length - 30);
  }
}

function getSlashHitbox() {
  const width = 46;
  const height = 34;

  const x = player.facing === 1
    ? player.x + player.width - 8
    : player.x - width + 8;

  const y = player.y + player.height * 0.12;

  return { x, y, width, height };
}

function getTitanNapeZone(titan) {
  const rect = getTitanDrawRect(titan);

  const zoneW = rect.width * 0.14;
const zoneH = rect.height * 0.07;
const zoneY = rect.y + rect.height * 0.08;

  let zoneX;

  if (titan.faceDir === 1) {
    zoneX = rect.x + rect.width * 0.34;
  } else {
    zoneX = rect.x + rect.width * 0.44;
  }

  return {
    x: zoneX,
    y: zoneY,
    width: zoneW,
    height: zoneH
  };
}

function attackTitanIfPossible(titan) {
  if (!titan.alive || titan.hitCooldown > 0 || player.attackTimer <= 0) return false;

  const slash = getSlashHitbox();
  const nape = getTitanNapeZone(titan);

  const titanBody = {
    x: titan.x,
    y: titan.y,
    width: titan.width,
    height: titan.height
  };

  const hitBody = rectsCollide(slash, titanBody);

  const fastDiagonalAttack =
    !player.onGround &&
    Math.abs(player.vx) > 5 &&
    Math.abs(player.vy) > 3;

  const napeTolerance = fastDiagonalAttack ? 10 : 0;

  const expandedNape = {
    x: nape.x - napeTolerance,
    y: nape.y - napeTolerance,
    width: nape.width + napeTolerance * 2,
    height: nape.height + napeTolerance * 2
  };

  const hitNape = rectsCollide(slash, expandedNape);

  const playerCenterX = player.x + player.width / 2;
  const titanCenterX = titan.x + titan.width / 2;

  const playerBehindTitan =
    (titan.faceDir === 1 && playerCenterX < titanCenterX - titan.width * 0.08) ||
    (titan.faceDir === -1 && playerCenterX > titanCenterX + titan.width * 0.08);

  const validNapeKill = hitNape && playerBehindTitan;

  if (!hitBody && !hitNape) return false;

  let damage = 1;

  if (player.boostMode) {
    damage = 2;
  } else if (Math.abs(player.vx) > 4.8 || Math.abs(player.vy) > 5.2) {
    damage = 2;
  }

  if (!hitNape) {
    // Zırhlı Dev'in gövde zırhı hasarı azaltır ama tamamen engellemez.
    // Böylece can barı her başarılı vuruşta görünür biçimde azalır.
    if (titan.isArmoredTitan) {
      damage = Math.max(1, damage * 0.75);
    } else {
      damage = 0.5;
    }

    titan.bodyHitCount++;

    // Zırhlı ve Maymun Dev kendi özel davranışlarını kullandığı için
    // normal devlerin üç gövde vuruşu sonrası öfkelenme davranışına girmez.
    if (
      !titan.isArmoredTitan &&
      !titan.isBeastTitan &&
      titan.bodyHitCount >= 3
    ) {
      titan.rageTimer = 35;
      titan.bodyHitCount = 0;
      titan.attackCooldown = 0;
      titan.attackFlashTimer = 18;
      titan.stunTimer = 0;
      titan.state = "attack";

      titan.faceDir = playerCenterX < titanCenterX ? -1 : 1;
      titan.dir = titan.faceDir;
    }
  } else {
    titan.bodyHitCount = 0;
  }

  titan.health -= damage;

  // Son vuruş mutlaka arkadan enseye gelmelidir.
  if (titan.health <= 0 && !validNapeKill) {
    titan.health = 1;
  }

  let armoredStaggerTriggered = false;

  if (
    titan.isArmoredTitan &&
    titan.staggerCooldown <= 0 &&
    titan.staggerImmunityTimer <= 0
  ) {
    titan.staggerHitCount = (titan.staggerHitCount || 0) + 1;

    if (titan.staggerHitCount >= (titan.staggerHitsNeeded || 4)) {
      titan.staggerHitCount = 0;
      titan.staggerCooldown = 460;
      titan.staggerImmunityTimer = 560;
      titan.stunTimer = titan.staggerDuration || 150;
      titan.state = "hurt";
      titan.attackFlashTimer = 0;
      titan.rageTimer = 0;

      // Hücumunu kes ve oyuncuya ensesine geçme fırsatı ver.
      titan.specialAttackMode = "idle";
      titan.specialAttackTimer = 0;
      titan.specialAttackCooldown = Math.max(titan.specialAttackCooldown || 0, 180);
      bossSpecialWarning = null;

      armoredStaggerTriggered = true;
      screenShakeTimer = Math.max(screenShakeTimer, 12);
    }
  }

  if (
    (titan.isArmoredTitan || titan.isBeastTitan) &&
    !armoredStaggerTriggered &&
    titan.stunTimer <= 0
  ) {
    titan.counterHitCount = (titan.counterHitCount || 0) + 1;

    if (titan.counterHitCount >= (titan.counterHitsNeeded || 3)) {
      titan.counterHitCount = 0;
      titan.specialAttackMode = "warning";
      titan.specialAttackTimer = titan.isArmoredTitan ? 55 : 60;
      titan.specialAttackCooldown = 0;
      titan.attackFlashTimer = titan.specialAttackTimer;
      bossSpecialWarning = {
        text: titan.isArmoredTitan ? "ARMORED TITAN COUNTER!" : "BEAST TITAN COUNTER!",
        timer: titan.specialAttackTimer,
        type: titan.isArmoredTitan ? "charge" : "beast"
      };
    }
  }

  titan.hitCooldown = hitNape ? 16 : 8;
  titan.bloodTimer = 10;

  if (armoredStaggerTriggered || (titan.isArmoredTitan && titan.stunTimer > 20)) {
    titan.state = "hurt";
  } else if (hitNape) {
    titan.stunTimer = Math.max(titan.stunTimer, 20);
    titan.state = "hurt";
  } else if (titan.rageTimer <= 0) {
    titan.state = "walk";
  }

  const bloodX = hitNape ? nape.x + nape.width / 2 : slash.x + slash.width / 2;
  const bloodY = hitNape ? nape.y + nape.height / 2 : slash.y + slash.height / 2;

  spawnBlood(bloodX, bloodY, player.boostMode ? 18 : 10);
  playSfx("titanHit", 0.3, 180);

  if (titan.isFemaleTitan && isRoofChaseSector && femaleAttackMode === "charge") {
    femaleAttackHits++;

    if (femaleAttackHits >= femaleAttackHitsNeeded) {
      femaleAttackMode = "retreat";
      femaleAttackTimer = 90;
      femaleAttackCooldown = getFemaleAttackCooldown();
      femaleTargetCivilian = false;
      civilianDangerTimer = 0;

      titan.stunTimer = 35;
      titan.state = "hurt";
      screenShakeTimer = 12;
    }
  }

  player.vx *= 0.35;
  player.vy = Math.min(player.vy, -2.8);

  if (titan.health <= 0 && validNapeKill) {
    finalStrikeTimer = 26;
    screenShakeTimer = Math.max(screenShakeTimer, 18);

    game.timeScale = 0.28;

    setTimeout(() => {
      game.timeScale = 1;
    }, 350);

    titan.alive = false;
    titan.state = "dead";
    titan.deadTimer = 300;
    titan.drawDead = true;
    titan.steamSpawned = false;

    spawnBlood(bloodX, bloodY, 38);

    playSfx("titanDeath", 0.45, 1200);
    playSfx("napeKill", 0.55, 500);

    killScore += titan.maxHealth * 140;
    titanKillCount++;

    if (isFemaleTitanFinalSector && titan.isFemaleTitan) {
      femaleFinalPhase = "fallenTitan";
      femaleExtractProgress = 0;
      annieCrystalTimer = 0;

      addKillCombo();
      return true;
    }

    addKillCombo();
    updateObjectiveProgress();
  }

  return true;
}

