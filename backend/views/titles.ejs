<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Scout Regiment Titles</title>

  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <%- include("partials/music") %>

  <style>
    :root{
      --panel:rgba(23,25,18,.82);
      --panel-soft:rgba(31,34,25,.74);
      --line:rgba(206,178,119,.26);
      --line-strong:rgba(206,178,119,.46);
      --cream:#f1e7cf;
      --muted:rgba(238,226,192,.72);
      --gold:#c9aa69;
    }

    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
    }

    html,body{
      width:100%;
      height:100%;
    }

    body{
      overflow:hidden;
      color:var(--cream);
      font-family:"Inter",Arial,sans-serif;
      background:
        linear-gradient(rgba(8,10,8,.22),rgba(8,10,8,.42)),
        url("/images/image6.png") center/cover fixed;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      background:
        radial-gradient(circle at 50% 0%,rgba(199,164,92,.05),transparent 36%),
        linear-gradient(90deg,rgba(0,0,0,.18),transparent 18%,transparent 82%,rgba(0,0,0,.18));
    }

    .page{
      width:100%;
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:16px;
    }

    .titles-shell{
      width:min(980px,92vw);
      height:min(640px,86vh);
      display:flex;
      flex-direction:column;
      overflow:hidden;
      border:1px solid var(--line-strong);
      background:var(--panel);
      box-shadow:
        0 24px 60px rgba(0,0,0,.58),
        inset 0 0 0 4px rgba(50,37,23,.52);
      backdrop-filter:blur(4px);
      -webkit-backdrop-filter:blur(4px);
    }

    .header{
      flex:0 0 auto;
      padding:16px 20px 14px;
      text-align:center;
      border-bottom:1px solid var(--line);
      background:rgba(0,0,0,.08);
    }

    .header h1{
      margin:0;
      color:#efe1b8;
      font-family:"Cinzel",serif;
      font-size:36px;
      line-height:1;
      letter-spacing:1.6px;
      text-transform:uppercase;
    }

    .header p{
      margin-top:6px;
      color:var(--muted);
      font-size:15px;
      line-height:1.4;
    }

    .content{
      flex:1 1 auto;
      min-height:0;
      display:grid;
      grid-template-columns:230px 1fr;
      gap:12px;
      padding:14px;
      overflow:hidden;
    }

    .summary-panel{
      display:flex;
      flex-direction:column;
      gap:9px;
      min-height:0;
    }

    .summary-card{
      padding:14px;
      border:1px solid var(--line);
      background:var(--panel-soft);
    }

    .summary-label{
      margin-bottom:7px;
      color:var(--gold);
      font-family:"Cinzel",serif;
      font-size:13px;
      font-weight:700;
      letter-spacing:1px;
      text-transform:uppercase;
    }

    .current-title{
      color:#ead08b;
      font-family:"Cinzel",serif;
      font-size:29px;
      font-weight:800;
      line-height:1.15;
      overflow-wrap:anywhere;
    }

    .stats-row{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:8px;
    }

    .stat-box{
      min-height:96px;
      padding:13px 9px;
      display:flex;
      flex-direction:column;
      justify-content:center;
      text-align:center;
      border:1px solid var(--line);
      background:rgba(0,0,0,.16);
    }

    .stat-name{
      margin-bottom:6px;
      color:rgba(238,226,192,.60);
      font-size:12px;
      font-weight:700;
      letter-spacing:.5px;
      text-transform:uppercase;
    }

    .stat-value{
      color:#f0ddb0;
      font-family:"Cinzel",serif;
      font-size:26px;
      font-weight:800;
    }

    .titles-area{
      min-width:0;
      min-height:0;
      display:flex;
      flex-direction:column;
      padding:12px;
      border:1px solid var(--line);
      background:rgba(18,20,16,.24);
    }

    .titles-head{
      flex:0 0 auto;
      margin-bottom:9px;
      padding-bottom:8px;
      border-bottom:1px solid var(--line);
    }

    .titles-head h2{
      margin:0;
      color:#e7d6ae;
      font-family:"Cinzel",serif;
      font-size:20px;
      letter-spacing:.6px;
      text-transform:uppercase;
    }

    .titles-grid{
      flex:1 1 auto;
      min-height:0;
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      grid-auto-rows:minmax(112px,auto);
      gap:8px;
      align-content:start;
      overflow-y:auto;
      padding-right:4px;
      scrollbar-width:thin;
      scrollbar-color:rgba(201,167,99,.45) rgba(0,0,0,.12);
    }

    .titles-grid::-webkit-scrollbar{
      width:7px;
    }

    .titles-grid::-webkit-scrollbar-track{
      background:rgba(0,0,0,.12);
    }

    .titles-grid::-webkit-scrollbar-thumb{
      background:rgba(201,167,99,.42);
      border-radius:8px;
    }

    .title-card{
      position:relative;
      min-height:112px;
      padding:13px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      border:1px solid var(--line);
      background:rgba(18,20,16,.42);
    }

    .title-card.unlocked{
      border-color:rgba(197,163,102,.38);
      background:
        linear-gradient(90deg,rgba(166,128,57,.17),rgba(18,20,16,.32));
    }

    .title-card.locked{
      opacity:.72;
    }

    .title-top{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:9px;
    }

    .title-name{
      color:#f0e5c9;
      font-family:"Cinzel",serif;
      font-size:17px;
      font-weight:800;
      line-height:1.25;
      overflow-wrap:anywhere;
    }

    .title-status{
      width:25px;
      height:25px;
      flex:0 0 25px;
      display:grid;
      place-items:center;
      border-radius:50%;
      color:#d8bd82;
      border:1px solid var(--line);
      background:rgba(0,0,0,.18);
      font-size:13px;
    }

    .unlocked .title-status{
      color:#dce9cf;
      background:rgba(83,105,70,.26);
      border-color:rgba(142,176,124,.36);
    }

    .requirement{
      margin-top:8px;
      padding-top:7px;
      border-top:1px solid rgba(199,167,109,.12);
      color:#c9ae72;
      font-size:12px;
      line-height:1.4;
    }

    .requirement strong{
      color:#f0dfb0;
    }

    @media (max-width:900px){
      .titles-shell{
        width:min(760px,94vw);
      }

      .content{
        grid-template-columns:205px 1fr;
      }

      .titles-grid{
        grid-template-columns:repeat(2,minmax(0,1fr));
      }
    }

    @media (max-width:720px){
      body{
        overflow:auto;
      }

      .page{
        height:auto;
        min-height:100vh;
        align-items:flex-start;
      }

      .titles-shell{
        height:auto;
        max-height:none;
      }

      .content{
        grid-template-columns:1fr;
        overflow:visible;
      }

      .titles-grid{
        grid-template-columns:1fr;
        overflow-y:visible;
        padding-right:0;
      }
    }
  </style>
</head>

<body>
  <%- include("partials/top-controls") %>

  <div class="page">
    <main class="titles-shell">
      <header class="header">
        <h1>Titles</h1>
        <p>Unlock new titles by defeating titans.</p>
      </header>

      <section class="content">
        <aside class="summary-panel">
          <div class="summary-card">
            <div class="summary-label">Current Title</div>
            <div class="current-title"><%= user.title || "Cadet" %></div>
          </div>

          <div class="stats-row">
            <div class="stat-box">
              <div class="stat-name">Titan Kills</div>
              <div class="stat-value"><%= user.titanKills || 0 %></div>
            </div>

            <div class="stat-box">
              <div class="stat-name">Unlocked</div>
              <div class="stat-value">
                <%= titleList.filter(title => (user.titanKills || 0) >= title.minKills).length %>
              </div>
            </div>
          </div>
        </aside>

        <div class="titles-area">
          <div class="titles-head">
            <h2>Available Titles</h2>
          </div>

          <div class="titles-grid">
            <% titleList.forEach(title => {
                 const unlocked = (user.titanKills || 0) >= title.minKills;
            %>
              <article class="title-card <%= unlocked ? 'unlocked' : 'locked' %>">
                <div class="title-top">
                  <div class="title-name"><%= title.name %></div>
                  <div class="title-status"><%= unlocked ? '✓' : '🔒' %></div>
                </div>

                <div class="requirement">
                  <%= unlocked ? 'Unlocked' : 'Requires' %>:
                  <strong><%= title.minKills %> titan kills</strong>
                </div>
              </article>
            <% }) %>
          </div>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
