<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Market</title>
  <%- include("partials/music") %>

  <style>
    *{ box-sizing:border-box; }

    body{
      margin:0;
      min-height:100vh;
      padding:40px 0;
      display:flex;
      justify-content:center;
      align-items:flex-start;
      background:#111;
      color:white;
      font-family:Arial, Helvetica, sans-serif;
      background-image:url("/images/image2.jpg");
      background-size:cover;
      background-position:center;
      background-attachment:fixed;
    }

    .box{
      width:980px;
      max-width:94vw;
      background:rgba(0,0,0,0.74);
      padding:32px 36px;
      border-radius:18px;
      box-shadow:0 0 30px rgba(0,0,0,0.45);
    }

    h1{
      text-align:center;
      margin:0 0 12px;
      font-size:34px;
    }

    .coins{
      text-align:center;
      margin-bottom:24px;
      font-size:18px;
      font-weight:bold;
    }

    .market-grid{
      display:grid;
      grid-template-columns:repeat(3, 1fr);
      gap:16px;
      margin-top:24px;
    }

    .item{
      min-height:230px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:flex-start;
      text-align:center;
      gap:8px;
      background:rgba(255,255,255,0.08);
      border:1px solid rgba(255,255,255,0.08);
      border-radius:14px;
      padding:16px 12px;
    }

    .skin-preview{
      width:82px;
      height:105px;
      object-fit:contain;
      margin-bottom:6px;
    }

    .item-title{
      font-weight:bold;
      font-size:16px;
      line-height:1.2;
    }

    .item-price{
      font-size:14px;
      opacity:.95;
    }

    .owned{
      font-size:13px;
      opacity:.9;
    }

    .selected{
      color:#ffd86b;
      font-weight:bold;
      opacity:1;
    }

    .actions{
      margin-top:auto;
      min-height:37px;
      display:flex;
      align-items:flex-end;
      justify-content:center;
    }

    .actions form{ margin:0; }

    button{
      border:none;
      border-radius:8px;
      padding:9px 15px;
      color:white;
      font-weight:bold;
      cursor:pointer;
      font-family:inherit;
    }

    .buy{ background:#2ecc71; }
    .select{ background:#3498db; }

    .chest-section{
      width:100%;
      margin:34px auto 18px;
      text-align:center;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
    }

    .chest-submit{
      background:none;
      border:none;
      padding:0;
      cursor:pointer;
      border-radius:14px;
    }

    .chest-img{
      width:150px;
      height:auto;
      display:block;
      cursor:pointer;
      transition:transform .15s ease, filter .15s ease;
    }

    .chest-img:hover{
      transform:scale(1.06);
      filter:brightness(1.1);
    }

    .chest-submit.disabled,
    .chest-submit:disabled{
      opacity:.45;
      cursor:not-allowed;
      filter:grayscale(0.5);
    }

    .chest-submit.disabled .chest-img,
    .chest-submit:disabled .chest-img{
      transform:none;
      filter:grayscale(.6);
      cursor:not-allowed;
    }

    .chest-error{
      min-height:20px;
      margin-top:8px;
      color:#ff7676;
      font-size:14px;
      font-weight:bold;
      text-align:center;
    }

    .chest-title{
      font-size:22px;
      font-weight:bold;
      margin-top:8px;
    }

    .chest-price{
      color:#ffd86b;
      font-weight:bold;
      margin-top:3px;
    }

    .chest-desc{
      max-width:560px;
      font-size:13px;
      margin-top:6px;
      opacity:.9;
      line-height:1.35;
    }

    .back-link{
      display:block;
      width:max-content;
      margin-top:28px;
      color:white;
      font-weight:bold;
      text-decoration:none;
    }

    .back-link:hover{ text-decoration:underline; }

    .chest-modal{
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,0.62);
      z-index:99999;
      align-items:center;
      justify-content:center;
      padding:20px;
    }

    .chest-modal.show{ display:flex; }

    .chest-modal-box{
      position:relative;
      width:560px;
      max-width:92vw;
      background:rgba(0,0,0,0.88);
      border:1px solid rgba(255,255,255,0.25);
      border-radius:18px;
      padding:34px 32px;
      text-align:center;
      color:white;
      box-shadow:0 0 35px rgba(0,0,0,0.65);
    }

    .chest-close{
      position:absolute;
      top:12px;
      right:14px;
      width:34px;
      height:34px;
      border:none;
      border-radius:50%;
      cursor:pointer;
      background:rgba(255,255,255,0.12);
      color:white;
      font-size:22px;
      font-weight:bold;
      line-height:1;
      padding:0;
    }

    .chest-open-img{
      width:150px;
      height:150px;
      object-fit:contain;
      margin:6px auto 12px;
      display:block;
    }

    .reward-img{
      width:110px;
      height:110px;
      object-fit:contain;
      margin:14px auto;
      display:none;
    }

    .reward-rarity{
      display:inline-block;
      margin:10px 0 16px;
      padding:6px 14px;
      border-radius:999px;
      font-size:13px;
      font-weight:bold;
      text-transform:uppercase;
    }

    .reward-rarity.common{
      color:#ddd;
      background:rgba(180,180,180,.18);
      border:1px solid rgba(220,220,220,.35);
    }

    .reward-rarity.rare{
      color:#74c7ff;
      background:rgba(52,152,219,.22);
      border:1px solid rgba(116,199,255,.45);
    }

    .reward-rarity.epic{
      color:#d89cff;
      background:rgba(155,89,182,.24);
      border:1px solid rgba(216,156,255,.45);
    }

    .reward-rarity.legendary{
      color:#ffd84d;
      background:rgba(241,196,15,.24);
      border:1px solid rgba(255,216,77,.55);
    }

    .chest-modal-actions{
      display:flex;
      justify-content:center;
      gap:12px;
      margin-top:24px;
      flex-wrap:wrap;
    }

    .chest-modal-actions a,
    .chest-modal-actions button{
      border:none;
      color:white;
      text-decoration:none;
      font-weight:bold;
      padding:10px 14px;
      border-radius:8px;
      cursor:pointer;
      font-family:inherit;
      font-size:14px;
    }

    .chest-modal-actions a{ background:#3498db; }
    .chest-modal-actions button{ background:#2ecc71; }

    @media (max-width:850px){
      .market-grid{ grid-template-columns:repeat(2, 1fr); }
    }

    @media (max-width:560px){
      .box{ padding:24px 18px; }
      .market-grid{ grid-template-columns:1fr; }
    }


    .chest-grid{
  display:grid;
  grid-template-columns:repeat(3, 1fr);
  gap:18px;
  margin:34px 0 22px;
}

.chest-card{
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.18);
  border-radius:16px;
  padding:18px 14px;
  text-align:center;
}

.chest-img{
  width:120px;
  height:120px;
  object-fit:contain;
}

.chest-title{
  font-size:20px;
  font-weight:bold;
  margin-top:8px;
}

.chest-price{
  color:#ffd86b;
  font-weight:bold;
  margin-top:4px;
}

.chest-desc{
  font-size:13px;
  opacity:.85;
  margin-top:6px;
  min-height:42px;
}

.chest-error{
  min-height:20px;
  margin-top:8px;
  color:#ff7676;
  font-size:13px;
  font-weight:bold;
}
  </style>
</head>

<body>
  <div class="box">
    <% const ownedSkins = Array.isArray(user.ownedSkins) ? user.ownedSkins : ["default"]; %>

    <h1>Market</h1>

    <div class="coins" id="coinBalance" data-coins="<%= user.coins || 0 %>">
      Keşif Madalyonu: <%= user.coins || 0 %>
    </div>

    <div class="market-grid">
      <% marketItems.forEach(item => { %>
        <div class="item">
          <% if(item.preview){ %>
            <img
              src="<%= item.preview %>"
              alt="<%= item.name %>"
              class="skin-preview"
            >
          <% } %>

          <div class="item-title"><%= item.name %></div>
          <div class="item-price">Fiyat: <%= item.price %> Keşif Madalyonu</div>

          <% if(ownedSkins.includes(item.key)){ %>
            <div class="owned">Owned</div>
          <% } %>

          <% if(user.selectedSkin === item.key){ %>
            <div class="owned selected">Selected</div>
          <% } %>

          <div class="actions">
            <% if(!ownedSkins.includes(item.key)){ %>
              <form action="/market/buy/<%= item.key %>" method="POST">
                <button class="buy" type="submit">Buy</button>
              </form>
            <% } else if(user.selectedSkin !== item.key) { %>
              <form action="/market/select/<%= item.key %>" method="POST">
                <button class="select" type="submit">Select</button>
              </form>
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="chest-grid">
  <% const chests = [
    {
      key: "scout",
      name: "Scout Chest",
      price: 1,
      img: "/images/ui/chest_scout.png",
      desc: "Temel ödüller, Keşif Madalyonu ve rare karakter rozetleri."
    },
    {
      key: "elite",
      name: "Elite Chest",
      price: 2,
      img: "/images/ui/chest_elite.png",
      desc: "Daha iyi ödüller, item hakları ve epic karakter rozetleri."
    },
    {
      key: "legend",
      name: "Legend Chest",
      price: 3,
      img: "/images/ui/chest_legend.png",
      desc: "En değerli ödüller, revive hakkı ve legendary rozet şansı."
    }
  ]; %>

  <% chests.forEach(chest => { %>
    <div class="chest-card">
      <form class="chestForm" data-chest-type="<%= chest.key %>">
        <button 
          type="submit" 
          class="chest-submit"
          data-price="<%= chest.price %>"
        >
          <img src="<%= chest.img %>" alt="<%= chest.name %>" class="chest-img">
        </button>
      </form>

      <div class="chest-title"><%= chest.name %></div>
      <div class="chest-price"><%= chest.price %> Keşif Madalyonu</div>
      <div class="chest-desc"><%= chest.desc %></div>
      <div class="chest-error"></div>
    </div>
  <% }) %>
</div>

    <a href="/menu" class="back-link">← Back to Menu</a>
  </div>

  <div id="chestModal" class="chest-modal">
    <div class="chest-modal-box">
      <button id="chestCloseBtn" class="chest-close" type="button">×</button>

      <h1>Sandık Açıldı!</h1>

      <img
        src="/images/ui/chest_open.png"
        alt="Sandık Açıldı"
        class="chest-open-img"
      >

      <img id="rewardImg" class="reward-img" src="" alt="Reward">

      <h2 id="rewardTitle"></h2>

      <div id="rewardRarity" class="reward-rarity common"></div>

      <p id="rewardDesc"></p>

      <div class="chest-modal-actions">
        <button id="openAnotherChestBtn" type="button">Tekrar Aç</button>
        <a href="/profile">Profilde Gör</a>
      </div>
    </div>
  </div>

  <script>
    
    let lastChestType = "scout";

const chestModal = document.getElementById("chestModal");
const chestCloseBtn = document.getElementById("chestCloseBtn");
const openAnotherChestBtn = document.getElementById("openAnotherChestBtn");
const coinBalance = document.getElementById("coinBalance");
const rewardImg = document.getElementById("rewardImg");
const rewardTitle = document.getElementById("rewardTitle");
const rewardRarity = document.getElementById("rewardRarity");
const rewardDesc = document.getElementById("rewardDesc");
    const CHEST_PRICE = 1;

    function getCurrentCoins() {
      return Number(coinBalance?.dataset.coins || 0);
    }

    function setCurrentCoins(amount) {
      if (!coinBalance) return;

      coinBalance.dataset.coins = amount;
      coinBalance.textContent = "Keşif Madalyonu: " + amount;
    }

  

    async function openChest(chestType = "scout", errorBox = null) { 
      
      lastChestType = chestType;

       try {
    if (errorBox) errorBox.textContent = "";


        const response = await fetch(`/chest/open/${chestType}`, {
    method: "POST",
    headers: {
      "Content-Type": "application/json"
    }
  });


        const data = await response.json();

        if (!data.success) {
  if (errorBox) errorBox.textContent = data.message || "Sandık açılamadı.";
  return;
}

        const result = data.result;

        if (typeof data.coins !== "undefined") {
          setCurrentCoins(data.coins);
        }

        rewardImg.style.display = "none";
        rewardImg.src = "";

        rewardRarity.className = "reward-rarity " + (result.rarity || "common");
        rewardRarity.textContent = result.rarity || "common";

        if (result.type === "coins") {
          rewardTitle.textContent = "+" + result.coinsGained + " Keşif Madalyonu";
          rewardDesc.textContent = "Sandıktan Keşif Madalyonu kazandın.";
        }

        if (result.type === "badge" && result.badge) {
          rewardImg.style.display = "block";
          rewardImg.src = result.badge.icon;

          rewardTitle.textContent = result.badge.name;
          rewardRarity.className = "reward-rarity " + result.badge.rarity;
          rewardRarity.textContent = result.badge.rarity;

          if (result.duplicate) {
            rewardDesc.textContent =
              "Bu karakter rozeti zaten sende vardı. Telafi ödülü: +" +
              result.coinsGained +
              " Keşif Madalyonu";
          } else {
            rewardDesc.textContent = "Yeni karakter rozeti koleksiyonuna eklendi!";
          }
        }

        chestModal.classList.add("show");
      } catch (error) {
        console.error("CHEST OPEN MODAL ERROR:", error);
        if (errorBox) errorBox.textContent = "Sandık açılırken hata oluştu. Console'a bak.";
      }
    }


    document.querySelectorAll(".chestForm").forEach(form => {
  form.addEventListener("submit", (e) => {
    e.preventDefault();

    const chestType = form.dataset.chestType;
    const button = form.querySelector(".chest-submit");
    const price = Number(button.dataset.price || 0);
    const errorBox = form.closest(".chest-card").querySelector(".chest-error");

    if (getCurrentCoins() < price) {
      errorBox.textContent = "Yeterli Keşif Madalyonu yok.";
      return;
    }

    errorBox.textContent = "";
openChest(chestType, errorBox);
  });
});

    if (chestCloseBtn) {
      chestCloseBtn.addEventListener("click", () => {
        chestModal.classList.remove("show");
      });
    }

    if (chestModal) {
      chestModal.addEventListener("click", (e) => {
        if (e.target === chestModal) {
          chestModal.classList.remove("show");
        }
      });
    }

    if (openAnotherChestBtn) {
      openAnotherChestBtn.addEventListener("click", () => {
        chestModal.classList.remove("show");
        openChest(lastChestType);
      });
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && chestModal.classList.contains("show")) {
        chestModal.classList.remove("show");
      }
    });

    
  </script>
</body>
</html>
