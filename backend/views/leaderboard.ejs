<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Leaderboard</title>
  <%- include("partials/music") %>
  <style>
    body{
      margin:0;
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      background:#111;
      color:white;
      font-family:Arial, Helvetica, sans-serif;
      background-image:url("/images/image5.jpg");
      background-size:cover;
      background-position:center;
    }

    .box{
      width:980px;
      max-width:92vw;
      background:rgba(0,0,0,0.75);
      padding:40px;
      border-radius:12px;
    }

    h1{
      text-align:center;
      margin-bottom:25px;
    }

    table{
      width:100%;
      border-collapse:collapse;
      background:rgba(255,255,255,0.08);
      overflow:hidden;
      border-radius:10px;
    }

    th, td{
      padding:14px;
      text-align:center;
      border-bottom:1px solid rgba(255,255,255,0.08);
    }

    th{
      background:rgba(255,255,255,0.12);
      font-size:14px;
    }

    tr:hover{
      background:rgba(255,255,255,0.07);
    }

    a{
      display:inline-block;
      margin-top:20px;
      color:white;
      text-decoration:none;
      font-weight:bold;
    }

    td a{
      color:white;
      text-decoration:none;
      font-weight:bold;
      margin-top:0;
    }

    td a:hover{
      text-decoration:underline;
      color:#00d8ff;
    }

    .power{
      font-weight:bold;
      color:#ffd166;
    }

    .rank{
      font-weight:bold;
      font-size:16px;
    }

    .empty-row td{
      opacity:.85;
      padding:22px;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>Leaderboard</h1>

    <table>
      <thead>
        <tr>
          <th>Rank</th>
          <th>Username</th>
          <th>Level</th>
          <th>Güç Puanı</th>
          <th>Tamamlanan Sector</th>
          <th>Titan Kills</th>
          <th>Rozet</th>
          <th>Keşif Madalyonu</th>
        </tr>
      </thead>

      <tbody>
        <% if(!topScores || topScores.length === 0){ %>
          <tr class="empty-row">
            <td colspan="7">No scores yet.</td>
          </tr>
        <% } %>

        <% topScores.forEach((entry, index) => { %>
          <tr>
            <td class="rank">
              <% if(index === 0){ %>🥇<% } %>
              <% if(index === 1){ %>🥈<% } %>
              <% if(index === 2){ %>🥉<% } %>
              <%= index + 1 %>
            </td>

            <td>
              <% if(entry._id){ %>
                <a href="/user/<%= entry._id %>"><%= entry.username %></a>
              <% } else { %>
                <span><%= entry.username %></span>
              <% } %>
            </td>

            <td><%= entry.level || 1 %></td>
            <td class="power"><%= entry.leaderboardPower || 0 %></td>
            <td><%= entry.completedSectorCount || 0 %></td>
            <td><%= entry.titanKills || 0 %></td>
            <td><%= entry.badgeCount || 0 %> adet / <%= entry.badgeScore || 0 %> puan</td>
            <td><%= entry.coins || 0 %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <a href="/menu">← Back to Menu</a>
  </div>
</body>
</html>
