<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <title>Profile</title>

  <%- include("partials/music") %>
  <style>
    body{
      margin:0;
      min-height:100vh;
      display:flex;
      justify-content:center;
      align-items:center;
      background:#111;
      color:white;
      font-family:Arial, Helvetica, sans-serif;
      background-image:url("/images/image2.jpg");
      background-size:cover;
      background-position:center;
    }

    .box{
      width:880px;
      max-width:92vw;
      background:rgba(0,0,0,0.75);
      padding:40px;
      border-radius:12px;
    }

    .top{
      display:flex;
      align-items:center;
      gap:20px;
      margin-bottom:25px;
    }

    .avatar img{
      width:110px;
      height:110px;
      object-fit:cover;
      border-radius:50%;
      border:3px solid white;
    }

    .info{
      flex:1;
    }

    .info h1{
      margin-bottom:8px;
    }

    .stat{
      margin-top:8px;
      padding:10px;
      background:rgba(255,255,255,0.08);
      border-radius:8px;
    }

    .profile-stats{
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(180px, 1fr));
      gap:12px;
      margin:24px 0;
    }

    .stat-card{
      background:rgba(255,255,255,0.08);
      border:1px solid rgba(255,255,255,0.14);
      border-radius:12px;
      padding:16px;
      text-align:center;
    }

    .stat-card h3{
      font-size:14px;
      margin:0 0 8px 0;
      opacity:.85;
    }

    .stat-card p{
      font-size:26px;
      font-weight:bold;
      margin:0;
    }

    a{
      display:inline-block;
      margin-top:20px;
      color:white;
      text-decoration:none;
      font-weight:bold;
    }

    a:hover{
      text-decoration:underline;
      color:#00d8ff;
    }

    .title-badge{
      display:inline-block;
      padding:4px 10px;
      border-radius:999px;
      background:rgba(255,255,255,0.12);
      margin-left:6px;
      font-weight:bold;
    }

    .badge-grid{
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));
      gap:14px;
      margin-top:14px;
    }

    .badge-card{
      background:rgba(255,255,255,0.08);
      border:1px solid rgba(255,255,255,0.18);
      border-radius:10px;
      padding:12px;
      text-align:center;
    }

    .badge-card img{
      width:70px;
      height:70px;
      object-fit:contain;
    }

    .badge-card .badge-name{
      font-weight:bold;
      margin-top:8px;
    }

    .badge-card .badge-rarity{
      font-size:12px;
      opacity:.8;
      text-transform:uppercase;
      margin-top:4px;
    }

    .titles-list{
      margin-top:10px;
    }

    .titles-list span{
      display:inline-block;
      padding:6px 10px;
      margin:4px;
      border-radius:999px;
      background:rgba(255,255,255,0.12);
      font-weight:bold;
    }
  </style>
</head>
<body>
  <div class="box">
    <div class="top">
      <div class="avatar">
        <img src="<%= profileUser.avatar %>" alt="avatar">
      </div>

      <div class="info">
        <h1><%= profileUser.username %></h1>

        <div class="stat">
          <strong>Title:</strong>
          <span class="title-badge"><%= profileUser.title %></span>
        </div>

        <div class="stat">
          <strong>Selected Skin:</strong> <%= profileUser.selectedSkin %>
        </div>
      </div>
    </div>

    <div class="profile-stats">
      <div class="stat-card">
        <h3>Level</h3>
        <p><%= profileUser.level || 1 %></p>
      </div>

      <div class="stat-card">
        <h3>Tamamlanan Sector</h3>
        <p><%= completedSectorCount || 0 %></p>
      </div>

      <div class="stat-card">
        <h3>Titan Kills</h3>
        <p><%= profileUser.titanKills || 0 %></p>
      </div>

      <div class="stat-card">
        <h3>Keşif Madalyonu</h3>
        <p><%= profileUser.coins || 0 %></p>
      </div>

      <div class="stat-card">
        <h3>Rozet Sayısı</h3>
        <p><%= ownedBadgeItems ? ownedBadgeItems.length : 0 %></p>
      </div>

      <div class="stat-card">
        <h3>Rozet Puanı</h3>
        <p><%= badgeScore || 0 %></p>
      </div>
    </div>

    <h2>Rozet Koleksiyonu</h2>

    <% if(!ownedBadgeItems || ownedBadgeItems.length === 0){ %>
      <p>Henüz rozetin yok. Sandık açarak rozet kazanabilirsin.</p>
    <% } else { %>
      <div class="badge-grid">
        <% ownedBadgeItems.forEach(badge => { %>
          <div class="badge-card">
            <img src="<%= badge.icon %>" alt="<%= badge.name %>">
            <div class="badge-name"><%= badge.name %></div>
            <div class="badge-rarity"><%= badge.rarity %></div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <div class="stat">
      <strong>Unlocked Titles:</strong>

      <div class="titles-list">
        <% if(profileUser.unlockedTitles && profileUser.unlockedTitles.length > 0){ %>
          <% profileUser.unlockedTitles.forEach(title => { %>
            <span><%= title %></span>
          <% }) %>
        <% } else { %>
          <span>No titles yet.</span>
        <% } %>
      </div>
    </div>

    <a href="/menu">← Back to Menu</a>
  </div>
</body>
</html>
