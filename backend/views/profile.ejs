<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scout Profile</title>

  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <%- include("partials/music") %>
<%- include("partials/top-controls") %>

  <style>
    :root{
      --panel:rgba(23,25,18,.80);
      --panel-soft:rgba(31,34,25,.72);
      --line:rgba(206,178,119,.26);
      --line-strong:rgba(206,178,119,.46);
      --cream:#f1e7cf;
      --muted:rgba(238,226,192,.68);
      --gold:#c9aa69;
    }

    *{margin:0;padding:0;box-sizing:border-box;}
    html,body{min-height:100%;}

    body{
      min-height:100vh;
      overflow-x:hidden;
      color:var(--cream);
      font-family:"Inter",Arial,sans-serif;
      background:
        linear-gradient(rgba(8,10,8,.22),rgba(8,10,8,.42)),
        url("/images/image2.png") center/cover fixed;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      background:
        radial-gradient(circle at 50% 0%,rgba(199,164,92,.05),transparent 36%),
        linear-gradient(90deg,rgba(0,0,0,.18),transparent 18%,transparent 82%,rgba(0,0,0,.18));
    }

    .page{
      width:100%;
      min-height:100vh;
      display:flex;
      align-items:center;
      justify-content:center;
      padding:18px;
    }

    .profile-shell{
      width:min(900px,90vw);
      max-height:88vh;
      overflow:auto;
      scrollbar-width:thin;
      scrollbar-color:rgba(201,167,99,.42) rgba(0,0,0,.12);
      border:1px solid var(--line-strong);
      background:var(--panel);
      box-shadow:0 24px 60px rgba(0,0,0,.58), inset 0 0 0 4px rgba(50,37,23,.52);
      backdrop-filter:blur(4px);
      -webkit-backdrop-filter:blur(4px);
    }

    .profile-shell::-webkit-scrollbar{
      width:7px;
    }

    .profile-shell::-webkit-scrollbar-track{
      background:rgba(0,0,0,.12);
    }

    .profile-shell::-webkit-scrollbar-thumb{
      background:rgba(201,167,99,.42);
      border-radius:8px;
    }

    .profile-header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:20px;
      padding:13px 16px;
      border-bottom:1px solid var(--line);
      background:rgba(0,0,0,.08);
    }

    .header-kicker{
      display:block;
      margin-bottom:5px;
      color:var(--gold);
      font-family:"Cinzel",serif;
      font-size:10px;
      font-weight:700;
      letter-spacing:2px;
      text-transform:uppercase;
    }

    .profile-header h1{
      color:#efe1b8;
      font-family:"Cinzel",serif;
      font-size:32px;
      line-height:1;
      letter-spacing:1.4px;
      text-transform:uppercase;
    }

    .header-subtitle{margin-top:7px;color:var(--muted);font-size:13px;}

    .back-link{
      flex:0 0 auto;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-width:145px;
      padding:10px 14px;
      color:#eadbb8;
      text-decoration:none;
      font-family:"Cinzel",serif;
      font-size:12px;
      font-weight:700;
      border:1px solid var(--line);
      background:rgba(0,0,0,.16);
    }

    .back-link:hover{background:rgba(76,86,64,.26);border-color:var(--line-strong);}

    .content{
      display:grid;
      grid-template-columns:225px 1fr;
      gap:10px;
      padding:12px;
    }

    .identity-panel,.records-panel,.collection-panel,.titles-panel{
      border:1px solid var(--line);
      background:var(--panel-soft);
    }

    .identity-panel{padding:18px;align-self:start;}

    .avatar-frame{
      width:104px;
      height:104px;
      margin:0 auto 10px;
      padding:4px;
      border:1px solid var(--line-strong);
      background:linear-gradient(145deg,#6d5433,#2e2418);
      box-shadow:inset 0 0 0 1px rgba(255,255,255,.08),0 8px 20px rgba(0,0,0,.34);
    }

    .avatar-frame img{width:100%;height:100%;display:block;object-fit:cover;background:#25251f;}

    .identity-name{
      margin:0 0 8px;
      color:#f0e5c9;
      font-family:"Cinzel",serif;
      font-size:25px;
      text-align:center;
      overflow-wrap:anywhere;
    }

    .identity-label{
      margin-bottom:4px;
      color:rgba(238,226,192,.48);
      font-size:10px;
      font-weight:700;
      letter-spacing:1.1px;
      text-transform:uppercase;
      text-align:center;
    }

    .current-title{
      margin-bottom:10px;
      color:#ead08b;
      font-family:"Cinzel",serif;
      font-size:18px;
      font-weight:800;
      text-align:center;
    }

    .identity-detail{
      display:flex;
      justify-content:space-between;
      gap:12px;
      padding:8px 0;
      border-top:1px solid rgba(199,167,109,.12);
      color:var(--muted);
      font-size:12px;
    }

    .identity-detail strong{color:#f0dfb0;text-align:right;overflow-wrap:anywhere;}

    .records-panel{padding:16px;}

    .section-title{
      margin-bottom:12px;
      color:#e7d6ae;
      font-family:"Cinzel",serif;
      font-size:18px;
      letter-spacing:.8px;
      text-transform:uppercase;
    }

    .stats-grid{
      display:grid;
      grid-template-columns:repeat(3,minmax(0,1fr));
      gap:7px;
    }

    .stat-card{
      min-height:82px;
      padding:9px 7px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      border:1px solid var(--line);
      background:rgba(0,0,0,.15);
    }

    .stat-card h3{
      margin:0 0 8px;
      color:rgba(238,226,192,.58);
      font-size:11px;
      font-weight:700;
      letter-spacing:.7px;
      text-transform:uppercase;
    }

    .stat-card p{margin:0;color:#f0ddb0;font-family:"Cinzel",serif;font-size:25px;font-weight:800;}

    .lower-grid{
      grid-column:1 / -1;
      display:grid;
      grid-template-columns:1.2fr .8fr;
      gap:10px;
    }

    .collection-panel,.titles-panel{padding:16px;min-height:250px;}

    .badge-grid{
      display:grid;
      grid-template-columns:repeat(4,minmax(0,1fr));
      gap:7px;
    }

    .badge-card{
      min-height:96px;
      padding:8px 5px;
      text-align:center;
      border:1px solid var(--line);
      background:rgba(18,20,16,.40);
    }

    .badge-card img{width:64px;height:64px;object-fit:contain;filter:drop-shadow(0 6px 8px rgba(0,0,0,.34));}
    .badge-name{margin-top:8px;color:#f0e5c9;font-family:"Cinzel",serif;font-size:12px;font-weight:800;line-height:1.25;}
    .badge-rarity{margin-top:4px;color:#c9ae72;font-size:9px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;}

    .empty-state{
      padding:28px 18px;
      color:var(--muted);
      text-align:center;
      font-size:13px;
      line-height:1.6;
      border:1px dashed rgba(199,167,109,.18);
      background:rgba(0,0,0,.10);
    }

    .titles-list{display:flex;flex-direction:column;gap:8px;}

    .title-item{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:7px;
      padding:8px 9px;
      color:#f0e5c9;
      font-family:"Cinzel",serif;
      font-size:13px;
      font-weight:700;
      border:1px solid var(--line);
      background:rgba(18,20,16,.38);
    }

    .title-item::after{
      content:"✓";
      color:#dce9cf;
      width:22px;
      height:22px;
      display:grid;
      place-items:center;
      border-radius:50%;
      background:rgba(83,105,70,.24);
      border:1px solid rgba(142,176,124,.34);
      font-size:10px;
    }

    @media (max-width:900px){
      .content{grid-template-columns:1fr;}
      .lower-grid{grid-template-columns:1fr;}
      .stats-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
      .badge-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
    }

    @media (max-width:620px){
      .page{padding:10px;align-items:flex-start;}
      .profile-shell::-webkit-scrollbar{
      width:7px;
    }

    .profile-shell::-webkit-scrollbar-track{
      background:rgba(0,0,0,.12);
    }

    .profile-shell::-webkit-scrollbar-thumb{
      background:rgba(201,167,99,.42);
      border-radius:8px;
    }

    .profile-header{align-items:flex-start;flex-direction:column;}
      .back-link{width:100%;}
      .badge-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
    }
  </style>
</head>

<body>
  <div class="page">
    <main class="profile-shell">
      <header class="profile-header">
        <div>
          <span class="header-kicker">Scout Regiment Record</span>
          <h1>Profile</h1>
          <p class="header-subtitle">Battle record, honors, and collected badges.</p>
        </div>

         <a href="/menu" class="back-link">← Back to Menu</a>
      </header>

      <section class="content">
        <aside class="identity-panel">
          <div class="avatar-frame">
            <img
              src="<%= profileUser.avatar || '/images/default-avatar.png' %>"
              alt="<%= profileUser.username %> avatar"
              onerror="this.onerror=null;this.src='/images/default-avatar.png';"
            >
          </div>

          <div class="identity-label">Scout</div>
          <h2 class="identity-name"><%= profileUser.username %></h2>

          <div class="identity-label">Current Title</div>
          <div class="current-title"><%= profileUser.title || "Cadet" %></div>

          <div class="identity-detail">
            <span>Selected Skin</span>
            <strong><%= profileUser.selectedSkin || "Default" %></strong>
          </div>

          <div class="identity-detail">
            <span>Level</span>
            <strong><%= profileUser.level || 1 %></strong>
          </div>
        </aside>

        <section class="records-panel">
          <h2 class="section-title">Battle Record</h2>

          <div class="stats-grid">
            <div class="stat-card">
              <h3>Completed Sectors</h3>
              <p><%= typeof completedSectorCount !== "undefined" ? completedSectorCount : 0 %></p>
            </div>

            <div class="stat-card">
              <h3>Titan Kills</h3>
              <p><%= profileUser.titanKills || 0 %></p>
            </div>

            <div class="stat-card">
              <h3>Scout Medallions</h3>
              <p><%= profileUser.coins || 0 %></p>
            </div>

            <div class="stat-card">
              <h3>Badges</h3>
              <p><%= ownedBadgeItems ? ownedBadgeItems.length : 0 %></p>
            </div>

            <div class="stat-card">
              <h3>Badge Points</h3>
              <p><%= typeof badgeScore !== "undefined" ? badgeScore : 0 %></p>
            </div>

            <div class="stat-card">
              <h3>Unlocked Titles</h3>
              <p><%= profileUser.unlockedTitles ? profileUser.unlockedTitles.length : 0 %></p>
            </div>
          </div>
        </section>

        <div class="lower-grid">
          <section class="collection-panel">
            <h2 class="section-title">Badge Collection</h2>

            <% if(!ownedBadgeItems || ownedBadgeItems.length === 0){ %>
              <div class="empty-state">
                No badges have been collected yet.<br>
                Open supply chests to earn new badges.
              </div>
            <% } else { %>
              <div class="badge-grid">
                <% ownedBadgeItems.forEach(badge => { %>
                  <article class="badge-card">
                    <img src="<%= badge.icon %>" alt="<%= badge.name %>">
                    <div class="badge-name"><%= badge.name %></div>
                    <div class="badge-rarity"><%= badge.rarity %></div>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </section>

          <section class="titles-panel">
            <h2 class="section-title">Unlocked Titles</h2>

            <div class="titles-list">
              <% if(profileUser.unlockedTitles && profileUser.unlockedTitles.length > 0){ %>
                <% profileUser.unlockedTitles.forEach(title => { %>
                  <div class="title-item"><%= title %></div>
                <% }) %>
              <% } else { %>
                <div class="empty-state">No titles unlocked yet.</div>
              <% } %>
            </div>
          </section>
        </div>
      </section>
    </main>
  </div>
</body>
</html>
